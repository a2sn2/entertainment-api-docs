{
  "info": {
    "_postman_id": "4c945c25-21a0-4db2-932d-c72b868d53c4",
    "name": "Entertainment Docs API",
    "description": "Import this collection with the Entertainment Docs - Local environment. Run Authentication/Login first; its test script stores the JWT in accessToken. Create Document and Create User store their generated identifiers for subsequent requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Platform",
      "item": [
        {
          "name": "Service Information",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login succeeded', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const response = pm.response.json();",
                  "  pm.environment.set('accessToken', response.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Public Documents",
      "item": [
        {
          "name": "List Published Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/documents", "host": ["{{baseUrl}}"], "path": ["api", "v1", "documents"] }
          }
        },
        {
          "name": "Get Published Document by Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/documents/{{documentSlug}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "documents", "{{documentSlug}}"] }
          }
        }
      ]
    },
    {
      "name": "Admin Documents",
      "item": [
        {
          "name": "Create Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Document created', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  const response = pm.response.json();",
                  "  pm.environment.set('documentId', response.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"API-ENT-DOC-POSTMAN-001\",\n  \"slug\": \"{{documentSlug}}\",\n  \"title\": \"Purchase API Integration Guide\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/documents", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "documents"] }
          }
        },
        {
          "name": "Add Document Version",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Version created', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const response = pm.response.json();",
                  "  pm.environment.set('documentVersionId', response.versionId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"1.0.0\",\n  \"content\": \"# Purchase API\\n\\nThis is the first published documentation version created from Postman.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/documents/{{documentId}}/versions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "documents", "{{documentId}}", "versions"] }
          }
        },
        {
          "name": "Submit Document for Review",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/documents/{{documentId}}/submit-review", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "documents", "{{documentId}}", "submit-review"] }
          }
        },
        {
          "name": "Publish Document",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/documents/{{documentId}}/publish", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "documents", "{{documentId}}", "publish"] }
          }
        }
      ]
    },
    {
      "name": "Admin Users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "users"] }
          }
        },
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User created', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  const response = pm.response.json();",
                  "  pm.environment.set('userId', response.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"editor.postman@local.test\",\n  \"displayName\": \"Postman Editor\",\n  \"temporaryPassword\": \"TempEditor!2026\",\n  \"roles\": [\n    \"Editor\",\n    \"Reader\"\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "users"] }
          }
        },
        {
          "name": "Replace User Roles",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roles\": [\n    \"Reviewer\",\n    \"Reader\"\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/users/{{userId}}/roles", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "users", "{{userId}}", "roles"] }
          }
        }
      ]
    }
  ]
}
