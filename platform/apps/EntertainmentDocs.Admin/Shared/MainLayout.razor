@inherits LayoutComponentBase
@inject AuthenticationApiClient Authentication
@inject NavigationManager Navigation

<MudThemeProvider Theme="@AppTheme.Default" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2">Entertainment Docs Admin</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       OnClick="ToggleTheme" />
        <AuthorizeView>
            <Authorized Context="authenticationState">
                <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit">
                    <MudMenuItem Disabled="true">@authenticationState.User.Identity?.Name</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="SignOutAsync">Sign out</MudMenuItem>
                </MudMenu>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Variant="@DrawerVariant.Responsive" Elevation="1">
        <MudDrawerHeader>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Api" Color="Color.Primary" />
                <MudText Typo="Typo.subtitle1">Platform</MudText>
            </MudStack>
        </MudDrawerHeader>
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
            <AuthorizeView Roles="Administrator,Editor,Reviewer">
                <MudNavLink Href="/documents" Icon="@Icons.Material.Filled.Description">Documents</MudNavLink>
            </AuthorizeView>
            <AuthorizeView Roles="Administrator">
                <MudNavLink Href="/users" Icon="@Icons.Material.Filled.ManageAccounts">Users &amp; roles</MudNavLink>
            </AuthorizeView>
            <MudNavLink Href="/api-reference" Icon="@Icons.Material.Filled.Terminal">API testing</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void ToggleTheme() => _isDarkMode = !_isDarkMode;

    private async Task SignOutAsync()
    {
        await Authentication.LogoutAsync();
        Navigation.NavigateTo("/login", replace: true);
    }
}
