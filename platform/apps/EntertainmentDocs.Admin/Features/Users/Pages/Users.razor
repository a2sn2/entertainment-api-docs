@page "/users"
@attribute [Authorize(Roles = "Administrator")]
@inject UsersApiClient UsersApi
@inject ISnackbar Snackbar

<PageTitle>Users and roles - Entertainment Docs</PageTitle>

<PageHeader Title="Users and roles"
            Subtitle="Create platform accounts and review their assigned access."
            Icon="@Icons.Material.Filled.ManageAccounts">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadAsync"
                   Disabled="_loading">
            Refresh
        </MudButton>
    </Actions>
</PageHeader>

<MudGrid Spacing="4">
    <MudItem xs="12" lg="8">
        @if (_loading)
        {
            <LoadingState Message="Loading users..." />
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <ErrorState Message="@_error" Retry="LoadAsync" />
        }
        else if (_users.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Filled.GroupOff"
                        Title="No users found"
                        Message="Create the first platform account using the form on this page." />
        }
        else
        {
            <MudPaper Elevation="0" Outlined="true">
                <MudTable Items="@_users" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Email</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Roles</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">@context.DisplayName</MudTd>
                        <MudTd DataLabel="Email">@context.Email</MudTd>
                        <MudTd DataLabel="Status">
                            <MudText Color="@(context.IsActive ? Color.Success : Color.Error)">
                                @(context.IsActive ? "Active" : "Inactive")
                            </MudText>
                        </MudTd>
                        <MudTd DataLabel="Roles">@(context.Roles.Count == 0 ? "No roles" : string.Join(", ", context.Roles))</MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager />
                    </PagerContent>
                </MudTable>
            </MudPaper>
        }
    </MudItem>

    <MudItem xs="12" lg="4">
        <MudPaper Class="pa-5" Elevation="0" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-4">Create user</MudText>
            <MudForm @ref="_createForm" @bind-IsValid="_createIsValid">
                <MudStack Spacing="3">
                    <MudTextField T="string"
                                  Label="Display name"
                                  @bind-Value="_createModel.DisplayName"
                                  Required="true"
                                  Variant="Variant.Outlined" />
                    <MudTextField T="string"
                                  Label="Email"
                                  @bind-Value="_createModel.Email"
                                  InputType="InputType.Email"
                                  Required="true"
                                  Variant="Variant.Outlined" />
                    <MudTextField T="string"
                                  Label="Temporary password"
                                  @bind-Value="_createModel.TemporaryPassword"
                                  InputType="InputType.Password"
                                  Required="true"
                                  Variant="Variant.Outlined" />

                    <MudText Typo="Typo.subtitle2">Roles</MudText>
                    <MudCheckBox T="bool" @bind-Value="_administrator" Label="Administrator" Color="Color.Primary" />
                    <MudCheckBox T="bool" @bind-Value="_editor" Label="Editor" Color="Color.Primary" />
                    <MudCheckBox T="bool" @bind-Value="_reviewer" Label="Reviewer" Color="Color.Primary" />
                    <MudCheckBox T="bool" @bind-Value="_reader" Label="Reader" Color="Color.Primary" />

                    <MudButton FullWidth="true"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.PersonAdd"
                               Disabled="_creating"
                               OnClick="CreateAsync">
                        @(_creating ? "Creating..." : "Create user")
                    </MudButton>
                </MudStack>
            </MudForm>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private IReadOnlyList<UserSummaryResponse> _users = [];
    private readonly CreateUserModel _createModel = new();
    private MudForm? _createForm;
    private bool _createIsValid;
    private bool _loading = true;
    private bool _creating;
    private bool _administrator;
    private bool _editor;
    private bool _reviewer;
    private bool _reader = true;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await UsersApi.ListAsync();
            if (!result.Succeeded || result.Value is null)
            {
                _error = result.Error ?? "Users could not be loaded.";
                return;
            }

            _users = result.Value;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateAsync()
    {
        if (_createForm is null)
            return;

        await _createForm.Validate();
        if (!_createIsValid)
            return;

        _creating = true;
        try
        {
            var roles = new List<string>();
            if (_administrator) roles.Add("Administrator");
            if (_editor) roles.Add("Editor");
            if (_reviewer) roles.Add("Reviewer");
            if (_reader) roles.Add("Reader");

            var request = new CreateUserRequest(
                _createModel.Email,
                _createModel.DisplayName,
                _createModel.TemporaryPassword,
                roles.ToArray());

            var result = await UsersApi.CreateAsync(request);
            if (!result.Succeeded)
            {
                Snackbar.Add(result.Error ?? "User creation failed.", Severity.Error);
                return;
            }

            Snackbar.Add("User created successfully.", Severity.Success);
            ResetCreateForm();
            await LoadAsync();
        }
        finally
        {
            _creating = false;
        }
    }

    private void ResetCreateForm()
    {
        _createModel.Email = string.Empty;
        _createModel.DisplayName = string.Empty;
        _createModel.TemporaryPassword = string.Empty;
        _administrator = false;
        _editor = false;
        _reviewer = false;
        _reader = true;
        _createForm?.ResetValidation();
    }

    private sealed class CreateUserModel
    {
        public string Email { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string TemporaryPassword { get; set; } = string.Empty;
    }
}
