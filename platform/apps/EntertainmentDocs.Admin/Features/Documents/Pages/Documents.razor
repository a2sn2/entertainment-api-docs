@page "/documents"
@attribute [Authorize(Roles = "Administrator,Editor,Reviewer")]
@inject DocumentsApiClient DocumentsApi
@inject ISnackbar Snackbar

<PageTitle>Documents - Entertainment Docs</PageTitle>

<PageHeader Title="Documentation workflow"
            Subtitle="Create, version, review, and publish API documentation through the protected backend workflow."
            Icon="@Icons.Material.Filled.Description" />

<MudPaper Class="pa-5 mb-5" Elevation="0" Outlined="true">
    <MudTextField T="string"
                  Label="Working document ID"
                  HelperText="Created documents are inserted automatically. Reviewers can paste an existing document ID here."
                  @bind-Value="_documentIdText"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Fingerprint" />
</MudPaper>

<MudTabs Rounded="true" Elevation="0" Outlined="true" ApplyEffectsToContainer="true" PanelClass="pa-5">
    <MudTabPanel Text="1. Create document" Icon="@Icons.Material.Filled.NoteAdd">
        <AuthorizeView Roles="Administrator,Editor">
            <Authorized>
                <MudForm @ref="_documentForm" @bind-IsValid="_documentIsValid">
                    <MudGrid Spacing="3">
                        <MudItem xs="12" md="4">
                            <MudTextField T="string"
                                          Label="Reference"
                                          @bind-Value="_document.Reference"
                                          Required="true"
                                          Variant="Variant.Outlined"
                                          HelperText="Unique business reference, for example API-ENT-DOC-001." />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string"
                                          Label="Slug"
                                          @bind-Value="_document.Slug"
                                          Required="true"
                                          Variant="Variant.Outlined"
                                          HelperText="URL-safe unique value, for example purchase-guide." />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string"
                                          Label="Title"
                                          @bind-Value="_document.Title"
                                          Required="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       Disabled="_busy"
                                       OnClick="CreateDocumentAsync">
                                Create draft
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudForm>
            </Authorized>
            <NotAuthorized>
                <MudAlert Severity="Severity.Warning">Your role can publish reviewed documents but cannot create drafts.</MudAlert>
            </NotAuthorized>
        </AuthorizeView>
    </MudTabPanel>

    <MudTabPanel Text="2. Add version" Icon="@Icons.Material.Filled.LibraryAdd">
        <AuthorizeView Roles="Administrator,Editor">
            <Authorized>
                <MudForm @ref="_versionForm" @bind-IsValid="_versionIsValid">
                    <MudStack Spacing="3">
                        <MudTextField T="string"
                                      Label="Version"
                                      @bind-Value="_version.Version"
                                      Required="true"
                                      Variant="Variant.Outlined"
                                      HelperText="For example 1.0.0." />
                        <MudTextField T="string"
                                      Label="Documentation content"
                                      @bind-Value="_version.Content"
                                      Required="true"
                                      Lines="14"
                                      Variant="Variant.Outlined"
                                      HelperText="Markdown or the complete content expected by the publishing workflow." />
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   Disabled="_busy"
                                   OnClick="AddVersionAsync">
                            Add version
                        </MudButton>
                    </MudStack>
                </MudForm>
            </Authorized>
            <NotAuthorized>
                <MudAlert Severity="Severity.Warning">Only Administrators and Editors can add versions.</MudAlert>
            </NotAuthorized>
        </AuthorizeView>
    </MudTabPanel>

    <MudTabPanel Text="3. Review and publish" Icon="@Icons.Material.Filled.Publish">
        <MudStack Spacing="4">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                Submit the document for review before publishing it. Both operations use the working document ID shown above.
            </MudAlert>

            <MudStack Row="true" Spacing="2">
                <AuthorizeView Roles="Administrator,Editor">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.RateReview"
                               Disabled="_busy"
                               OnClick="SubmitForReviewAsync">
                        Submit for review
                    </MudButton>
                </AuthorizeView>

                <AuthorizeView Roles="Administrator,Reviewer">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Publish"
                               Disabled="_busy"
                               OnClick="PublishAsync">
                        Publish
                    </MudButton>
                </AuthorizeView>
            </MudStack>
        </MudStack>
    </MudTabPanel>
</MudTabs>

@code {
    private readonly DocumentModel _document = new();
    private readonly VersionModel _version = new();
    private MudForm? _documentForm;
    private MudForm? _versionForm;
    private bool _documentIsValid;
    private bool _versionIsValid;
    private bool _busy;
    private string _documentIdText = string.Empty;

    private async Task CreateDocumentAsync()
    {
        if (_documentForm is null)
            return;

        await _documentForm.Validate();
        if (!_documentIsValid)
            return;

        await RunAsync(async () =>
        {
            var result = await DocumentsApi.CreateAsync(new CreateDocumentRequest(
                _document.Reference,
                _document.Slug,
                _document.Title));

            if (!result.Succeeded || result.Value is null)
            {
                Snackbar.Add(result.Error ?? "Document creation failed.", Severity.Error);
                return;
            }

            _documentIdText = result.Value.Id.ToString();
            Snackbar.Add("Draft document created. Continue with the version tab.", Severity.Success);
        });
    }

    private async Task AddVersionAsync()
    {
        if (_versionForm is null)
            return;

        await _versionForm.Validate();
        if (!_versionIsValid || !TryGetDocumentId(out var documentId))
            return;

        await RunAsync(async () =>
        {
            var result = await DocumentsApi.AddVersionAsync(
                documentId,
                new AddDocumentVersionRequest(_version.Version, _version.Content));

            Snackbar.Add(
                result.Succeeded ? "Document version added successfully." : result.Error ?? "Version creation failed.",
                result.Succeeded ? Severity.Success : Severity.Error);
        });
    }

    private async Task SubmitForReviewAsync()
    {
        if (!TryGetDocumentId(out var documentId))
            return;

        await RunAsync(async () =>
        {
            var result = await DocumentsApi.SubmitForReviewAsync(documentId);
            Snackbar.Add(
                result.Succeeded ? "Document submitted for review." : result.Error ?? "Submit for review failed.",
                result.Succeeded ? Severity.Success : Severity.Error);
        });
    }

    private async Task PublishAsync()
    {
        if (!TryGetDocumentId(out var documentId))
            return;

        await RunAsync(async () =>
        {
            var result = await DocumentsApi.PublishAsync(documentId);
            Snackbar.Add(
                result.Succeeded ? "Document published successfully." : result.Error ?? "Publishing failed.",
                result.Succeeded ? Severity.Success : Severity.Error);
        });
    }

    private bool TryGetDocumentId(out Guid documentId)
    {
        if (Guid.TryParse(_documentIdText, out documentId))
            return true;

        Snackbar.Add("Enter a valid document GUID first.", Severity.Warning);
        return false;
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class DocumentModel
    {
        public string Reference { get; set; } = string.Empty;
        public string Slug { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
    }

    private sealed class VersionModel
    {
        public string Version { get; set; } = "1.0.0";
        public string Content { get; set; } = string.Empty;
    }
}
