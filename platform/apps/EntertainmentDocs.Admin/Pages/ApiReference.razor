@page "/api-reference"
@attribute [Authorize]

<PageTitle>API testing - Entertainment Docs</PageTitle>

<PageHeader Title="API testing reference"
            Subtitle="Request bodies, authorization rules, and the recommended execution order for Postman or any REST client."
            Icon="@Icons.Material.Filled.Terminal" />

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-5">
    Import <strong>platform/postman/EntertainmentDocs.postman_collection.json</strong> and
    <strong>platform/postman/EntertainmentDocs.Local.postman_environment.json</strong> from the repository.
</MudAlert>

<MudExpansionPanels MultiExpansion="true" Elevation="0">
    <MudExpansionPanel Text="1. Login - POST /api/v1/auth/login" Expanded="true">
        <MudText Typo="Typo.body2" Class="mb-3">No Bearer token is required. The response accessToken is used by every protected request.</MudText>
        <MudPaper Class="pa-4" Style="overflow:auto;" Elevation="0" Outlined="true">
            <pre>{
  "email": "admin@local.test",
  "password": "LocalAdmin!2026"
}</pre>
        </MudPaper>
    </MudExpansionPanel>

    <MudExpansionPanel Text="2. Create document - POST /api/v1/admin/documents">
        <MudText Typo="Typo.body2" Class="mb-3">Roles: Administrator or Editor.</MudText>
        <MudPaper Class="pa-4" Style="overflow:auto;" Elevation="0" Outlined="true">
            <pre>{
  "reference": "API-ENT-DOC-001",
  "slug": "purchase-guide",
  "title": "Purchase API Integration Guide"
}</pre>
        </MudPaper>
    </MudExpansionPanel>

    <MudExpansionPanel Text="3. Add version - POST /api/v1/admin/documents/{id}/versions">
        <MudText Typo="Typo.body2" Class="mb-3">Roles: Administrator or Editor. Replace <code>{id}</code> with the created document GUID.</MudText>
        <MudPaper Class="pa-4" Style="overflow:auto;" Elevation="0" Outlined="true">
            <pre>{
  "version": "1.0.0",
  "content": "# Purchase API\n\nComplete documentation content."
}</pre>
        </MudPaper>
    </MudExpansionPanel>

    <MudExpansionPanel Text="4. Submit and publish">
        <MudText Typo="Typo.body2">These two POST requests have no body:</MudText>
        <MudList T="string" Dense="true">
            <MudListItem T="string" Icon="@Icons.Material.Filled.RateReview">POST /api/v1/admin/documents/{id}/submit-review</MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.Publish">POST /api/v1/admin/documents/{id}/publish</MudListItem>
        </MudList>
    </MudExpansionPanel>

    <MudExpansionPanel Text="5. Create user - POST /api/v1/admin/users">
        <MudText Typo="Typo.body2" Class="mb-3">Role: Administrator.</MudText>
        <MudPaper Class="pa-4" Style="overflow:auto;" Elevation="0" Outlined="true">
            <pre>{
  "email": "editor@local.test",
  "displayName": "Documentation Editor",
  "temporaryPassword": "TempEditor!2026",
  "roles": ["Editor", "Reader"]
}</pre>
        </MudPaper>
    </MudExpansionPanel>

    <MudExpansionPanel Text="6. Replace user roles - PUT /api/v1/admin/users/{id}/roles">
        <MudText Typo="Typo.body2" Class="mb-3">Role: Administrator. The array replaces all current assignments.</MudText>
        <MudPaper Class="pa-4" Style="overflow:auto;" Elevation="0" Outlined="true">
            <pre>{
  "roles": ["Reviewer", "Reader"]
}</pre>
        </MudPaper>
    </MudExpansionPanel>
</MudExpansionPanels>
