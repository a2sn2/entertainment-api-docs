<MudPaper Class="pa-8" Elevation="0" Outlined="true">
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
        <MudIcon Icon="@Icon" Color="Color.Secondary" Size="Size.Large" />
        <MudText Typo="Typo.h6">@Title</MudText>
        <MudText Typo="Typo.body2" Align="Align.Center">@Message</MudText>
        @if (Actions is not null)
        {
            <MudStack Row="true" Class="mt-2">@Actions</MudStack>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    public string Icon { get; set; } = Icons.Material.Filled.Inbox;

    [Parameter]
    public string Title { get; set; } = "Nothing here yet";

    [Parameter]
    public string Message { get; set; } = "No records are available.";

    [Parameter]
    public RenderFragment? Actions { get; set; }
}
