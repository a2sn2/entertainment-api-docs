<MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="false">
    <MudStack Spacing="2">
        <MudText Typo="Typo.subtitle1">@Title</MudText>
        <MudText Typo="Typo.body2">@Message</MudText>
        @if (Retry.HasDelegate)
        {
            <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Retry">
                Try again
            </MudButton>
        }
    </MudStack>
</MudAlert>

@code {
    [Parameter]
    public string Title { get; set; } = "Something went wrong";

    [Parameter]
    public string Message { get; set; } = "The request could not be completed.";

    [Parameter]
    public EventCallback Retry { get; set; }
}
