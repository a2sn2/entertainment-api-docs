@page "/documents/{Slug}"
@inject DocumentationApiClient Api

<PageTitle>@(_document?.Title ?? "Documentation")</PageTitle>

@if (_loading)
{
    <LoadingState Message="Loading documentation..." />
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <ErrorState Message="@_error" Retry="LoadAsync" />
}
else if (_document is not null)
{
    <PageHeader Title="@_document.Title"
                Subtitle="@($"{_document.Reference} · Version {_document.Version} · Updated {_document.UpdatedAt.LocalDateTime:yyyy-MM-dd HH:mm}")"
                Icon="@Icons.Material.Filled.Article">
        <Actions>
            <MudButton Href="/" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack">All documents</MudButton>
        </Actions>
    </PageHeader>

    <MudPaper Class="pa-6" Elevation="0" Outlined="true">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
            <MudText Typo="Typo.subtitle2">Published content</MudText>
            <MudText Typo="Typo.caption" Color="Color.Success">@_document.Status</MudText>
        </MudStack>
        <pre style="white-space:pre-wrap;word-break:break-word;margin:0;">@_document.Content</pre>
    </MudPaper>
}

@code {
    private DocumentDetailsResponse? _document;
    private bool _loading = true;
    private string? _error;

    [Parameter]
    public string Slug { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await Api.GetBySlugAsync(Slug);
            if (!result.Succeeded || result.Value is null)
            {
                _error = result.Error ?? "The document could not be loaded.";
                return;
            }

            _document = result.Value;
        }
        finally
        {
            _loading = false;
        }
    }
}
