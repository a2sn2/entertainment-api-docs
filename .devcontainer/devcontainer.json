{
  "name": "Entertainment Docs Full Stack",
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-8.0-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Entertainment Docs Platform",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postCreateCommand": "chmod +x platform/scripts/*.sh && dotnet restore platform/EntertainmentDocs.sln",
  "postAttachCommand": "printf '\nCodespace ready. Run: bash platform/scripts/start-test-stack.sh\n\n'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens"
      ]
    }
  },
  "remoteUser": "vscode"
}
