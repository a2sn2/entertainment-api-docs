<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>FoundationKit.Workbench</RootNamespace>
    <IsPackable>false</IsPackable>
    <UserSecretsId>FoundationKit.Workbench-Local</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FoundationKit.Domain\FoundationKit.Domain.csproj" />
    <ProjectReference Include="..\..\src\FoundationKit.Application\FoundationKit.Application.csproj" />
    <ProjectReference Include="..\..\src\FoundationKit.Infrastructure\FoundationKit.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\FoundationKit.WebApi\FoundationKit.WebApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\catalog\foundationkit.catalog.json">
      <Link>catalog\foundationkit.catalog.json</Link>
      <TargetPath>catalog\foundationkit.catalog.json</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\site\**\*">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <TargetPath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
