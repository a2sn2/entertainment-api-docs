@page "/"
@inject WorkbenchApiClient Api

<PageTitle>FoundationKit — Dual Full Stack</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-8">
    <section class="hero-grid">
        <div>
            <div class="eyebrow">FOUNDATIONKIT REFERENCE ARCHITECTURE</div>
            <MudText Typo="Typo.h2" Class="hero-title">كور واحد واضح، وتجربتان Full‑Stack مكتملتان.</MudText>
            <MudText Typo="Typo.h6" Class="hero-copy">
                المستودع يعرض مسار المستخدم ومسار الإدارة من قاعدة البيانات حتى Blazor وUI/UX، ثم يوضح نقطة الربط بينهما في دورة طلب قابلة للتجربة.
            </MudText>
            <MudStack Row="true" Spacing="2" Class="mt-6 flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="user" StartIcon="@Icons.Material.Filled.Person">
                    افتح بوابة المستخدم
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="admin" StartIcon="@Icons.Material.Filled.AdminPanelSettings">
                    افتح لوحة الإدارة
                </MudButton>
                <MudButton Variant="Variant.Text" Href="swagger" Target="_blank" StartIcon="@Icons.Material.Filled.Api">
                    Swagger
                </MudButton>
            </MudStack>
        </div>

        <div class="core-orbit" aria-hidden="true">
            <div class="orbit orbit-one"></div>
            <div class="orbit orbit-two"></div>
            <div class="core-node">FK</div>
            <span class="satellite satellite-api">API</span>
            <span class="satellite satellite-ui">UI</span>
            <span class="satellite satellite-db">SQL</span>
        </div>
    </section>

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-4 flex-wrap">
        <MudChip T="string" Color="@RuntimeColor" Variant="Variant.Outlined">@RuntimeLabel</MudChip>
        <MudText Class="muted-text">@RuntimeDescription</MudText>
    </MudStack>

    <section class="section-block">
        <div class="section-heading">
            <div>
                <div class="eyebrow">TWO VERTICAL SLICES</div>
                <MudText Typo="Typo.h3">القسمان الرسميان داخل الكور المرجعي</MudText>
            </div>
            <MudText Class="muted-text">كل قسم يملك واجهته وعقوده وEndpoints ومنطقه ومسار البيانات.</MudText>
        </div>

        <MudGrid>
            <MudItem xs="12" lg="6">
                <MudPaper Class="portal-card user-portal-card" Elevation="0">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" Color="Color.Primary" />
                    <MudText Typo="Typo.h4" Class="mt-3">User Full Stack</MudText>
                    <MudText Class="muted-text mt-2">تجربة المستخدم لإنشاء الطلب ومتابعة حالته بعد معالجة الإدارة.</MudText>
                    <div class="stack-chain">
                        <span>SQL Server</span><b>→</b><span>EF Core</span><b>→</b><span>Domain</span><b>→</b><span>Use Case</span><b>→</b><span>Request Contract</span><b>→</b><span>API</span><b>→</b><span>Blazor UI/UX</span>
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="user" FullWidth="true" Class="mt-5">
                        استكشف مسار المستخدم
                    </MudButton>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="6">
                <MudPaper Class="portal-card admin-portal-card" Elevation="0">
                    <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Typo="Typo.h4" Class="mt-3">Admin Full Stack</MudText>
                    <MudText Class="muted-text mt-2">تجربة الإدارة لقراءة قائمة العمل ومراجعة الطلب واعتماده أو رفضه.</MudText>
                    <div class="stack-chain">
                        <span>SQL Server</span><b>→</b><span>EF Query</span><b>→</b><span>Review Domain</span><b>→</b><span>Use Case</span><b>→</b><span>Admin Contract</span><b>→</b><span>API</span><b>→</b><span>Admin UI/UX</span>
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="admin" FullWidth="true" Class="mt-5">
                        استكشف مسار الإدارة
                    </MudButton>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </section>

    <section class="section-block integration-shell">
        <div class="section-heading">
            <div>
                <div class="eyebrow">INTEGRATION BOUNDARY</div>
                <MudText Typo="Typo.h3">أين يرتبط القسمان؟</MudText>
            </div>
        </div>

        <div class="workflow-line">
            <div class="workflow-step"><strong>1</strong><span>المستخدم يرسل الطلب</span><small>POST /api/user/requests</small></div>
            <div class="workflow-arrow">←</div>
            <div class="workflow-step active"><strong>2</strong><span>Shared Workflow</span><small>Status = submitted</small></div>
            <div class="workflow-arrow">←</div>
            <div class="workflow-step"><strong>3</strong><span>الإدارة تراجع الطلب</span><small>POST /api/admin/requests/{id}/review</small></div>
            <div class="workflow-arrow">←</div>
            <div class="workflow-step"><strong>4</strong><span>المستخدم يرى النتيجة</span><small>approved / rejected</small></div>
        </div>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-6">
            الربط هنا يتم داخل معاملة واحدة: تُحفظ مراجعة الإدارة في <code>AdminReviews</code> وتتغير حالة طلب المستخدم في <code>BuildBriefs</code> معًا.
        </MudAlert>
    </section>

    <section class="section-block">
        <div class="section-heading">
            <div>
                <div class="eyebrow">REPOSITORY READING ORDER</div>
                <MudText Typo="Typo.h3">كيف يفهم أي مطور المستودع؟</MudText>
            </div>
        </div>

        <MudGrid>
            @foreach (var item in ReadingOrder)
            {
                <MudItem xs="12" md="6" lg="3">
                    <MudPaper Class="architecture-card" Elevation="0">
                        <MudText Typo="Typo.subtitle2" Color="Color.Primary">@item.Number</MudText>
                        <MudText Typo="Typo.h6" Class="mt-2">@item.Title</MudText>
                        <MudText Class="muted-text mt-2">@item.Description</MudText>
                        <code class="repo-path">@item.Path</code>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </section>
</MudContainer>

@code {
    private RuntimeResponse? _runtime;

    private Color RuntimeColor => _runtime?.Mode == "local" ? Color.Success : Color.Warning;
    private string RuntimeLabel => _runtime?.Mode == "local" ? "LOCAL FULL STACK" : "STATIC DEMO";
    private string RuntimeDescription => _runtime?.Mode == "local"
        ? "Blazor + API + SQL Server يعملون من نفس الـHost."
        : "GitHub Pages يعرض المعمارية والواجهات فقط دون حفظ أو مراجعات فعلية.";

    private static readonly IReadOnlyList<ReadingItem> ReadingOrder =
    [
        new("01", "Reusable Core", "المكونات العامة المستقلة عن المنتج.", "src/FoundationKit.*"),
        new("02", "User Stack", "العقود والمنطق والـAPI وصفحة المستخدم.", "Contracts/User + Application/User + /user"),
        new("03", "Admin Stack", "قائمة العمل والمراجعة وعقود ولوحة الإدارة.", "Contracts/Admin + Application/Admin + /admin"),
        new("04", "Integration", "الحالة المشتركة والحدث والمهاجرة التي تربط القسمين.", "Domain/WorkflowState + AdminReviews")
    ];

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetRuntimeAsync();
        _runtime = result.IsSuccess && result.Value is not null
            ? result.Value
            : new RuntimeResponse("demo", "none", "none", "ALHassan ALShami");
    }

    private sealed record ReadingItem(
        string Number,
        string Title,
        string Description,
        string Path);
}
