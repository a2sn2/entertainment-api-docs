@page "/admin"
@inject WorkbenchApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Admin Full Stack</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-8">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-6 flex-wrap">
        <MudButton Variant="Variant.Text" Href="/" StartIcon="@Icons.Material.Filled.ArrowBack">الخريطة الرئيسية</MudButton>
        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">ADMIN FULL STACK</MudChip>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ReloadAsync" StartIcon="@Icons.Material.Filled.Refresh">تحديث القائمة</MudButton>
    </MudStack>

    <section class="portal-hero admin-portal-card">
        <div>
            <div class="eyebrow">ADMIN EXPERIENCE</div>
            <MudText Typo="Typo.h2">قائمة عمل الإدارة من SQL Server حتى قرار الاعتماد.</MudText>
            <MudText Typo="Typo.h6" Class="muted-text mt-3">
                هذه الصفحة هي نهاية مسار الإدارة: Admin UI → typed client → Admin Contract → Admin API → Review Use Case → Domain Transition → EF Core → SQL Server.
            </MudText>
        </div>
        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Large" Color="Color.Secondary" />
    </section>

    @if (_runtime?.Mode != "local")
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-6">
            هذه بيانات عرض داخل GitHub Pages. شغّل الـAPI محليًا لقراءة الطلبات الفعلية وتنفيذ قرارات الإدارة.
        </MudAlert>
    }

    <MudStack Row="true" Spacing="1" Class="mt-8 flex-wrap">
        @foreach (var filter in Filters)
        {
            <MudButton Variant="@(_status == filter.Value ? Variant.Filled : Variant.Outlined)"
                       Color="@StatusColor(filter.Value)"
                       OnClick="() => ChangeFilterAsync(filter.Value)">
                @filter.Label
            </MudButton>
        }
    </MudStack>

    @if (_loading)
    {
        <div class="loading-panel">
            <MudProgressCircular Indeterminate="true" Color="Color.Secondary" Size="Size.Large" />
            <MudText>جاري قراءة قائمة الإدارة...</MudText>
        </div>
    }
    else if (_items.Count == 0)
    {
        <MudPaper Class="empty-state mt-6" Elevation="0">
            <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" />
            <MudText Typo="Typo.h5" Class="mt-3">لا توجد طلبات في هذه الحالة</MudText>
            <MudText Class="muted-text">أنشئ طلبًا من بوابة المستخدم ثم ارجع إلى قائمة الإدارة.</MudText>
            <MudButton Href="user" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-4">فتح بوابة المستخدم</MudButton>
        </MudPaper>
    }
    else
    {
        <MudGrid Class="mt-6">
            <MudItem xs="12" lg="7">
                <div class="admin-queue">
                    @foreach (var item in _items)
                    {
                        <button type="button"
                                class="queue-card @(_selected?.Id == item.Id ? "selected" : string.Empty)"
                                @onclick="() => Select(item)">
                            <div class="queue-card-head">
                                <div>
                                    <strong>@item.ProjectName</strong>
                                    <small>@item.ProjectType</small>
                                </div>
                                <span class="status-pill @item.Status">@StatusLabel(item.Status)</span>
                            </div>
                            <p>@item.Goal</p>
                            <div class="queue-meta">
                                <span>@item.Audience</span>
                                <span>@item.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                        </button>
                    }
                </div>
            </MudItem>

            <MudItem xs="12" lg="5">
                @if (_selected is null)
                {
                    <MudPaper Class="empty-state" Elevation="0">
                        <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Large" />
                        <MudText Typo="Typo.h6" Class="mt-3">اختر طلبًا لمراجعة تفاصيله</MudText>
                    </MudPaper>
                }
                else
                {
                    <MudPaper Class="review-panel" Elevation="0">
                        <MudText Typo="Typo.h4">@_selected.ProjectName</MudText>
                        <MudText Class="muted-text mt-2">@_selected.Goal</MudText>

                        <div class="detail-list mt-5">
                            <div><span>الجمهور</span><strong>@_selected.Audience</strong></div>
                            <div><span>الأولويات</span><strong>@ValueOrDash(_selected.Priorities)</strong></div>
                            <div><span>القدرات</span><strong>@string.Join("، ", _selected.SelectedCapabilityIds)</strong></div>
                            <div><span>الحالة</span><strong>@StatusLabel(_selected.Status)</strong></div>
                        </div>

                        @if (string.Equals(_selected.Status, WorkflowStatuses.Submitted, StringComparison.OrdinalIgnoreCase))
                        {
                            <MudDivider Class="my-5" />
                            <MudText Typo="Typo.h6">قرار الإدارة</MudText>
                            <MudTextField T="string" Label="اسم المراجع" @bind-Value="_review.ReviewedBy" Required="true" Variant="Variant.Outlined" Class="mt-4" />
                            <MudTextField T="string" Label="ملاحظات القرار" @bind-Value="_review.Notes" Lines="4" Variant="Variant.Outlined" Class="mt-4" />

                            <MudStack Row="true" Spacing="2" Class="mt-5">
                                <MudButton FullWidth="true"
                                           Variant="Variant.Filled"
                                           Color="Color.Success"
                                           Disabled="@DecisionDisabled"
                                           OnClick="() => ReviewAsync(ReviewDecisions.Approve)"
                                           StartIcon="@Icons.Material.Filled.CheckCircle">
                                    اعتماد
                                </MudButton>
                                <MudButton FullWidth="true"
                                           Variant="Variant.Filled"
                                           Color="Color.Error"
                                           Disabled="@DecisionDisabled"
                                           OnClick="() => ReviewAsync(ReviewDecisions.Reject)"
                                           StartIcon="@Icons.Material.Filled.Cancel">
                                    رفض
                                </MudButton>
                            </MudStack>
                        }
                    </MudPaper>
                }
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private readonly List<AdminQueueItemResponse> _items = [];
    private readonly AdminReviewRequest _review = new() { ReviewedBy = "Admin" };
    private RuntimeResponse? _runtime;
    private AdminQueueItemResponse? _selected;
    private string _status = WorkflowStatuses.Submitted;
    private bool _loading = true;
    private bool _reviewing;

    private bool DecisionDisabled =>
        _reviewing || _runtime?.Mode != "local" || string.IsNullOrWhiteSpace(_review.ReviewedBy);

    private static readonly IReadOnlyList<FilterOption> Filters =
    [
        new(WorkflowStatuses.Submitted, "بانتظار المراجعة"),
        new(WorkflowStatuses.Approved, "المعتمدة"),
        new(WorkflowStatuses.Rejected, "المرفوضة")
    ];

    protected override async Task OnInitializedAsync()
    {
        var runtimeResult = await Api.GetRuntimeAsync();
        _runtime = runtimeResult.IsSuccess && runtimeResult.Value is not null
            ? runtimeResult.Value
            : new RuntimeResponse("demo", "none", "none", "ALHassan ALShami");

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _items.Clear();

        if (_runtime?.Mode == "local")
        {
            var result = await Api.GetAdminQueueAsync(_status);
            if (result.IsSuccess && result.Value is not null)
                _items.AddRange(result.Value);
            else
                Snackbar.Add(result.Error ?? "تعذر قراءة قائمة الإدارة.", Severity.Error);
        }
        else
        {
            _items.AddRange(CreateDemoItems(_status));
        }

        _selected = _items.FirstOrDefault();
        _loading = false;
    }

    private async Task ChangeFilterAsync(string status)
    {
        _status = status;
        await ReloadAsync();
    }

    private void Select(AdminQueueItemResponse item)
    {
        _selected = item;
        _review.Notes = string.Empty;
    }

    private async Task ReviewAsync(string decision)
    {
        if (_selected is null)
            return;

        _reviewing = true;
        _review.Decision = decision;
        var result = await Api.ReviewUserRequestAsync(_selected.Id, _review);
        _reviewing = false;

        if (result.IsFailure || result.Value is null)
        {
            Snackbar.Add(result.Error ?? "تعذر حفظ قرار الإدارة.", Severity.Error);
            return;
        }

        Snackbar.Add(decision == ReviewDecisions.Approve ? "تم اعتماد الطلب." : "تم رفض الطلب.", Severity.Success);
        await ReloadAsync();
    }

    private static IEnumerable<AdminQueueItemResponse> CreateDemoItems(string status)
    {
        if (!string.Equals(status, WorkflowStatuses.Submitted, StringComparison.OrdinalIgnoreCase))
            return [];

        var now = DateTimeOffset.UtcNow;
        return
        [
            new AdminQueueItemResponse(
                Guid.Parse("8A34A6F4-B76E-4A8C-A9AE-035CCBDF87C1"),
                "منصة إدارة عمليات الفروع",
                "منصة عمليات داخلية",
                "موظفو الفروع والمشرفون",
                "توحيد الطلبات والموافقات والتقارير التشغيلية في مسار واحد.",
                ["commands-queries", "ef-repository", "result-http-mapping"],
                "التدقيق وسهولة الاستخدام",
                "بيانات تجريبية للعرض فقط",
                WorkflowStatuses.Submitted,
                now.AddHours(-3),
                now.AddHours(-3)),
            new AdminQueueItemResponse(
                Guid.Parse("5B84C2F1-A4D0-49CE-88D9-4869AC5229D3"),
                "نظام خدمة العملاء",
                "نظام خدمة عملاء",
                "الموظفون والمشرفون",
                "إدارة الرسائل والمهام والتصعيد من واجهة موحدة.",
                ["aggregate-domain-events", "typed-api-results"],
                "سرعة الاستجابة والصلاحيات",
                "بيانات تجريبية للعرض فقط",
                WorkflowStatuses.Submitted,
                now.AddHours(-1),
                now.AddHours(-1))
        ];
    }

    private static Color StatusColor(string status) => status switch
    {
        WorkflowStatuses.Approved => Color.Success,
        WorkflowStatuses.Rejected => Color.Error,
        _ => Color.Warning
    };

    private static string StatusLabel(string status) => status.ToLowerInvariant() switch
    {
        WorkflowStatuses.Approved => "معتمد",
        WorkflowStatuses.Rejected => "مرفوض",
        _ => "بانتظار المراجعة"
    };

    private static string ValueOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;

    private sealed record FilterOption(string Value, string Label);
}
