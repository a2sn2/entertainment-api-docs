@page "/user"
@using System.Text.Json
@inject WorkbenchApiClient Api
@inject ISnackbar Snackbar

<PageTitle>User Full Stack</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-8">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-6 flex-wrap">
        <MudButton Variant="Variant.Text" Href="/" StartIcon="@Icons.Material.Filled.ArrowBack">الخريطة الرئيسية</MudButton>
        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">USER FULL STACK</MudChip>
        <MudSpacer />
        <MudChip T="string" Color="@RuntimeColor" Variant="Variant.Text">@RuntimeLabel</MudChip>
    </MudStack>

    <section class="portal-hero user-portal-card">
        <div>
            <div class="eyebrow">USER EXPERIENCE</div>
            <MudText Typo="Typo.h2">أنشئ طلبًا وتابع حالته من نفس البوابة.</MudText>
            <MudText Typo="Typo.h6" Class="muted-text mt-3">
                هذه الصفحة هي نهاية مسار المستخدم: Razor UI → typed client → User Contract → User API → Use Case → Domain → EF Core → SQL Server.
            </MudText>
        </div>
        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" Color="Color.Primary" />
    </section>

    @if (_loading)
    {
        <div class="loading-panel">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <MudText>جاري تحميل الكتالوج ومسار المستخدم...</MudText>
        </div>
    }
    else
    {
        <MudGrid Class="mt-8">
            <MudItem xs="12" lg="7">
                <MudPaper Class="form-panel" Elevation="0">
                    <MudText Typo="Typo.h4">بيانات الطلب</MudText>
                    <MudText Class="muted-text mt-2">كل حقل هنا يطابق <code>CreateUserRequest</code> ويمكن إرساله بنفس الشكل من Postman.</MudText>

                    <MudForm @ref="_form" Class="mt-5">
                        <MudTextField T="string" Label="اسم المشروع" @bind-Value="_request.ProjectName" Required="true" RequiredError="اسم المشروع مطلوب" Variant="Variant.Outlined" />
                        <MudSelect T="string" Label="نوع المشروع" @bind-Value="_request.ProjectType" Required="true" RequiredError="نوع المشروع مطلوب" Variant="Variant.Outlined" Class="mt-4">
                            <MudSelectItem Value="@("منصة عمليات داخلية")">منصة عمليات داخلية</MudSelectItem>
                            <MudSelectItem Value="@("نظام خدمة عملاء")">نظام خدمة عملاء</MudSelectItem>
                            <MudSelectItem Value="@("نظام مالي")">نظام مالي</MudSelectItem>
                            <MudSelectItem Value="@("بوابة مستخدم")">بوابة مستخدم</MudSelectItem>
                            <MudSelectItem Value="@("أخرى")">أخرى</MudSelectItem>
                        </MudSelect>
                        <MudTextField T="string" Label="المستخدمون المستهدفون" @bind-Value="_request.Audience" Required="true" RequiredError="حدد المستخدمين المستهدفين" Variant="Variant.Outlined" Class="mt-4" />
                        <MudTextField T="string" Label="الهدف والنتيجة المطلوبة" @bind-Value="_request.Goal" Required="true" RequiredError="الهدف مطلوب" Lines="4" Variant="Variant.Outlined" Class="mt-4" />
                        <MudTextField T="string" Label="الأولويات" @bind-Value="_request.Priorities" Lines="3" Variant="Variant.Outlined" Class="mt-4" />
                        <MudTextField T="string" Label="ملاحظات غير سرية" @bind-Value="_request.Notes" Lines="3" Variant="Variant.Outlined" Class="mt-4" />
                    </MudForm>

                    <MudText Typo="Typo.h6" Class="mt-6">قدرات FoundationKit المطلوبة</MudText>
                    <div class="capability-grid mt-3">
                        @foreach (var capability in Capabilities)
                        {
                            <button type="button"
                                    class="capability-toggle @(IsSelected(capability.Id) ? "selected" : string.Empty)"
                                    @onclick="() => ToggleCapability(capability.Id)">
                                <span class="capability-check">@(IsSelected(capability.Id) ? "✓" : "+")</span>
                                <strong>@capability.TitleAr</strong>
                                <small>@capability.DescriptionAr</small>
                            </button>
                        }
                    </div>

                    @if (_runtime?.Mode != "local")
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-5">
                            وضع GitHub Pages يعرض تجربة المستخدم فقط. شغّل الـAPI محليًا لحفظ الطلب في SQL Server.
                        </MudAlert>
                    }

                    <MudButton FullWidth="true"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               Class="mt-5"
                               Disabled="@SubmitDisabled"
                               OnClick="SubmitAsync"
                               StartIcon="@Icons.Material.Filled.Send">
                        @(_submitting ? "جاري الإرسال..." : "إرسال الطلب إلى مسار المستخدم")
                    </MudButton>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="5">
                <MudPaper Class="request-preview" Elevation="0">
                    <MudText Typo="Typo.h6">POST /api/user/requests</MudText>
                    <MudText Typo="Typo.caption" Class="muted-text">Content-Type: application/json</MudText>
                    <pre>@RequestPreview</pre>
                </MudPaper>

                @if (_result is not null)
                {
                    <MudPaper Class="result-panel mt-4" Elevation="0">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                        <MudText Typo="Typo.h5" Class="mt-2">تم إنشاء الطلب</MudText>
                        <MudText>المعرّف: @_result.Id</MudText>
                        <MudChip T="string" Color="@StatusColor(_result.Status)" Variant="Variant.Filled" Class="mt-3">@StatusLabel(_result.Status)</MudChip>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Class="mt-4" OnClick="RefreshStatusAsync">
                            تحديث حالة الطلب
                        </MudButton>
                        <MudButton Href="@_result.ContactUrl" Target="_blank" Variant="Variant.Text" FullWidth="true" Class="mt-2">
                            فتح ملخص التواصل
                        </MudButton>
                    </MudPaper>
                }
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private readonly JsonSerializerOptions _jsonOptions = new(JsonSerializerDefaults.Web)
    {
        WriteIndented = true
    };

    private readonly HashSet<string> _selectedCapabilities = new(StringComparer.OrdinalIgnoreCase);
    private MudForm? _form;
    private CreateUserRequest _request = new();
    private CatalogResponse? _catalog;
    private RuntimeResponse? _runtime;
    private UserRequestResponse? _result;
    private bool _loading = true;
    private bool _submitting;

    private IEnumerable<CapabilityResponse> Capabilities =>
        (_catalog?.Packages ?? []).SelectMany(package => package.Capabilities);

    private Color RuntimeColor => _runtime?.Mode == "local" ? Color.Success : Color.Warning;
    private string RuntimeLabel => _runtime?.Mode == "local" ? "SQL CONNECTED" : "DEMO ONLY";
    private bool SubmitDisabled => _submitting || _runtime?.Mode != "local";

    private string RequestPreview
    {
        get
        {
            _request.SelectedCapabilityIds = _selectedCapabilities.OrderBy(id => id).ToArray();
            return JsonSerializer.Serialize(_request, _jsonOptions);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var runtimeResult = await Api.GetRuntimeAsync();
        _runtime = runtimeResult.IsSuccess && runtimeResult.Value is not null
            ? runtimeResult.Value
            : new RuntimeResponse("demo", "none", "none", "ALHassan ALShami");

        var catalogResult = await Api.GetCatalogAsync();
        _catalog = catalogResult.IsSuccess ? catalogResult.Value : null;
        _loading = false;
    }

    private bool IsSelected(string capabilityId) =>
        _selectedCapabilities.Contains(capabilityId);

    private void ToggleCapability(string capabilityId)
    {
        if (!_selectedCapabilities.Add(capabilityId))
            _selectedCapabilities.Remove(capabilityId);
    }

    private async Task SubmitAsync()
    {
        if (_form is null)
            return;

        await _form.Validate();
        if (!_form.IsValid)
            return;

        _submitting = true;
        _request.SelectedCapabilityIds = _selectedCapabilities.OrderBy(id => id).ToArray();
        var result = await Api.CreateUserRequestAsync(_request);
        _submitting = false;

        if (result.IsFailure || result.Value is null)
        {
            Snackbar.Add(result.Error ?? "تعذر إنشاء الطلب.", Severity.Error);
            return;
        }

        _result = result.Value;
        Snackbar.Add("تم إرسال الطلب إلى قائمة الإدارة.", Severity.Success);
    }

    private async Task RefreshStatusAsync()
    {
        if (_result is null)
            return;

        var result = await Api.GetUserRequestAsync(_result.Id);
        if (result.IsSuccess && result.Value is not null)
        {
            _result = result.Value;
            Snackbar.Add("تم تحديث الحالة.", Severity.Info);
        }
    }

    private static Color StatusColor(string status) => status.ToLowerInvariant() switch
    {
        WorkflowStatuses.Approved => Color.Success,
        WorkflowStatuses.Rejected => Color.Error,
        _ => Color.Warning
    };

    private static string StatusLabel(string status) => status.ToLowerInvariant() switch
    {
        WorkflowStatuses.Approved => "معتمد",
        WorkflowStatuses.Rejected => "مرفوض",
        _ => "بانتظار مراجعة الإدارة"
    };
}
