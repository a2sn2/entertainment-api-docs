@inherits LayoutComponentBase

<MudThemeProvider IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="workbench-appbar">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <div class="brand-mark">FK</div>
            <div>
                <MudText Typo="Typo.h6">FoundationKit Workbench</MudText>
                <MudText Typo="Typo.caption" Class="muted-text">Blazor WebAssembly · MudBlazor · ASP.NET Core API · SQL Server</MudText>
            </div>
        </MudStack>
        <MudSpacer />
        <MudButton Href="swagger" Target="_blank" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Api">
            Swagger API
        </MudButton>
        <MudIconButton Href="https://github.com/a2sn2/foundationkit-dotnet" Target="_blank" Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit" />
    </MudAppBar>

    <MudMainContent Class="workbench-main" dir="rtl">
        @Body
    </MudMainContent>
</MudLayout>
