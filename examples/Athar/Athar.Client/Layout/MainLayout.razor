@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AtharApiClient Api
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudThemeProvider IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="athar-appbar">
        <MudLink Href="/" Underline="Underline.None" Class="brand-link">
            <div class="brand-mark">أ</div>
            <div>
                <MudText Typo="Typo.h6">أثَر</MudText>
                <MudText Typo="Typo.caption">من الفكرة إلى أثر قابل للقياس</MudText>
            </div>
        </MudLink>

        <MudSpacer />

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudButton Href="/" Variant="Variant.Text">الرئيسية</MudButton>
            <AuthorizeView Context="userContext">
                <Authorized>
                    <MudButton Href="/initiatives" Variant="Variant.Text">مبادراتي</MudButton>
                    <AuthorizeView Roles="@AtharRoles.Administrator" Context="adminContext">
                        <MudButton Href="/admin" Variant="Variant.Text">لوحة الإدارة</MudButton>
                    </AuthorizeView>
                    <MudButton Variant="Variant.Outlined" OnClick="LogoutAsync">
                        خروج
                    </MudButton>
                </Authorized>
                <NotAuthorized>
                    <MudButton Href="/account" Color="Color.Primary" Variant="Variant.Filled">
                        دخول
                    </MudButton>
                </NotAuthorized>
            </AuthorizeView>
        </MudStack>
    </MudAppBar>

    <MudMainContent Class="athar-main" dir="rtl">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private async Task LogoutAsync()
    {
        var result = await Api.LogoutAsync();
        if (result.IsFailure)
        {
            Snackbar.Add(result.Error ?? "تعذر تسجيل الخروج.", Severity.Error);
            return;
        }

        if (AuthenticationStateProvider is AtharAuthenticationStateProvider provider)
            provider.Refresh();

        Snackbar.Add("تم تسجيل الخروج.", Severity.Success);
        Navigation.NavigateTo("/", forceLoad: true);
    }
}
