@page "/account"
@implements IDisposable
@inject AccountViewModel ViewModel
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>الحساب — منصة أثر</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-12">
    <MudPaper Class="athar-card account-shell" Elevation="0">
        <div class="account-intro">
            <div class="eyebrow">بوابة آمنة</div>
            <MudText Typo="Typo.h3">حساب أثَر</MudText>
            <MudText Class="muted-copy mt-3">
                Cookie آمنة، حماية CSRF، قفل للمحاولات المتكررة، تأكيد بريد واستعادة كلمة المرور،
                مع دعم تطبيقات المصادقة الثنائية ورموز الاسترداد.
            </MudText>
        </div>

        <MudTabs Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
            <MudTabPanel Text="تسجيل الدخول">
                <MudForm @ref="_loginForm">
                    <MudTextField T="string" Label="البريد الإلكتروني"
                                  @bind-Value="ViewModel.Login.Email" Required="true"
                                  InputType="InputType.Email" Variant="Variant.Outlined" />
                    <MudTextField T="string" Label="كلمة المرور"
                                  @bind-Value="ViewModel.Login.Password" Required="true"
                                  InputType="InputType.Password" Variant="Variant.Outlined" Class="mt-4" />
                    <MudCheckBox T="bool" Label="تذكرني"
                                 @bind-Value="ViewModel.Login.RememberMe" Class="mt-3" />
                    <MudButton FullWidth="true" Color="Color.Primary" Variant="Variant.Filled"
                               Size="Size.Large" Disabled="ViewModel.IsBusy"
                               OnClick="LoginAsync" Class="mt-5">
                        @(ViewModel.IsBusy ? "جاري الدخول..." : "دخول")
                    </MudButton>
                </MudForm>

                @if (ViewModel.RequiresTwoFactor)
                {
                    <MudDivider Class="my-6" />
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        الحساب محمي بالمصادقة الثنائية. أدخل رمز التطبيق المكوّن من 6 أرقام أو رمز استرداد محفوظًا لديك.
                    </MudAlert>
                    <MudTextField T="string" Label="رمز المصادقة أو الاسترداد"
                                  @bind-Value="ViewModel.TwoFactor.Code"
                                  Variant="Variant.Outlined" Class="mt-4" />
                    <MudCheckBox T="bool" Label="تذكر هذا الجهاز"
                                 @bind-Value="ViewModel.TwoFactor.RememberMachine" Class="mt-3" />
                    <MudButton FullWidth="true" Color="Color.Primary" Variant="Variant.Filled"
                               Disabled="ViewModel.IsBusy" OnClick="TwoFactorAsync" Class="mt-4">
                        إكمال التحقق
                    </MudButton>
                }
            </MudTabPanel>

            <MudTabPanel Text="إنشاء حساب">
                <MudForm @ref="_registerForm">
                    <MudTextField T="string" Label="الاسم"
                                  @bind-Value="ViewModel.Register.DisplayName" Required="true"
                                  Variant="Variant.Outlined" />
                    <MudTextField T="string" Label="البريد الإلكتروني"
                                  @bind-Value="ViewModel.Register.Email" Required="true"
                                  InputType="InputType.Email" Variant="Variant.Outlined" Class="mt-4" />
                    <MudTextField T="string" Label="كلمة المرور"
                                  HelperText="سيطبق الخادم سياسة كلمة المرور المعتمدة للبيئة الحالية؛ القيم الإنتاجية النهائية قرار أمني تنظيمي صريح."
                                  @bind-Value="ViewModel.Register.Password" Required="true"
                                  InputType="InputType.Password" Variant="Variant.Outlined" Class="mt-4" />
                    <MudButton FullWidth="true" Color="Color.Primary" Variant="Variant.Filled"
                               Size="Size.Large" Disabled="ViewModel.IsBusy"
                               OnClick="RegisterAsync" Class="mt-5">
                        @(ViewModel.IsBusy ? "جاري الإنشاء..." : "إنشاء الحساب")
                    </MudButton>
                </MudForm>
            </MudTabPanel>

            <MudTabPanel Text="التأكيد والاستعادة">
                <MudText Typo="Typo.h6">البريد الإلكتروني</MudText>
                <MudTextField T="string" Label="البريد الإلكتروني"
                              @bind-Value="ViewModel.RecoveryEmail.Email"
                              InputType="InputType.Email" Variant="Variant.Outlined" Class="mt-3" />
                <MudStack Row="true" Spacing="2" Class="mt-3">
                    <MudButton Color="Color.Primary" Variant="Variant.Outlined"
                               Disabled="ViewModel.IsBusy" OnClick="RequestConfirmationAsync">
                        إرسال رمز تأكيد
                    </MudButton>
                    <MudButton Color="Color.Secondary" Variant="Variant.Outlined"
                               Disabled="ViewModel.IsBusy" OnClick="ForgotPasswordAsync">
                        نسيت كلمة المرور
                    </MudButton>
                </MudStack>

                <MudDivider Class="my-6" />
                <MudText Typo="Typo.h6">تأكيد البريد</MudText>
                <MudTextField T="string" Label="البريد الإلكتروني"
                              @bind-Value="ViewModel.Confirmation.Email"
                              InputType="InputType.Email" Variant="Variant.Outlined" Class="mt-3" />
                <MudTextField T="string" Label="رمز التأكيد"
                              @bind-Value="ViewModel.Confirmation.Token"
                              Variant="Variant.Outlined" Class="mt-3" Lines="3" />
                <MudButton Color="Color.Primary" Variant="Variant.Filled"
                           Disabled="ViewModel.IsBusy" OnClick="ConfirmEmailAsync" Class="mt-3">
                    تأكيد البريد
                </MudButton>

                <MudDivider Class="my-6" />
                <MudText Typo="Typo.h6">إعادة تعيين كلمة المرور</MudText>
                <MudTextField T="string" Label="البريد الإلكتروني"
                              @bind-Value="ViewModel.PasswordReset.Email"
                              InputType="InputType.Email" Variant="Variant.Outlined" Class="mt-3" />
                <MudTextField T="string" Label="رمز الاستعادة"
                              @bind-Value="ViewModel.PasswordReset.Token"
                              Variant="Variant.Outlined" Class="mt-3" Lines="3" />
                <MudTextField T="string" Label="كلمة المرور الجديدة"
                              @bind-Value="ViewModel.PasswordReset.NewPassword"
                              InputType="InputType.Password" Variant="Variant.Outlined" Class="mt-3" />
                <MudButton Color="Color.Primary" Variant="Variant.Filled"
                           Disabled="ViewModel.IsBusy" OnClick="ResetPasswordAsync" Class="mt-3">
                    حفظ كلمة المرور الجديدة
                </MudButton>
            </MudTabPanel>

            @if (ViewModel.CurrentUser?.IsAuthenticated == true)
            {
                <MudTabPanel Text="أمان الحساب">
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        البريد: @(ViewModel.CurrentUser.EmailConfirmed ? "مؤكد" : "غير مؤكد") —
                        المصادقة الثنائية: @(ViewModel.CurrentUser.TwoFactorEnabled ? "مفعلة" : "غير مفعلة")
                    </MudAlert>

                    <MudText Typo="Typo.h6" Class="mt-6">تغيير كلمة المرور</MudText>
                    <MudTextField T="string" Label="كلمة المرور الحالية"
                                  @bind-Value="ViewModel.PasswordChange.CurrentPassword"
                                  InputType="InputType.Password" Variant="Variant.Outlined" Class="mt-3" />
                    <MudTextField T="string" Label="كلمة المرور الجديدة"
                                  @bind-Value="ViewModel.PasswordChange.NewPassword"
                                  InputType="InputType.Password" Variant="Variant.Outlined" Class="mt-3" />
                    <MudButton Color="Color.Primary" Variant="Variant.Filled"
                               Disabled="ViewModel.IsBusy" OnClick="ChangePasswordAsync" Class="mt-3">
                        تغيير كلمة المرور
                    </MudButton>

                    <MudDivider Class="my-6" />
                    <MudText Typo="Typo.h6">المصادقة الثنائية</MudText>
                    @if (ViewModel.MfaStatus?.TwoFactorEnabled == true)
                    {
                        <MudText Class="muted-copy mt-2">
                            المصادقة الثنائية مفعلة. رموز الاسترداد المتبقية: @ViewModel.MfaStatus.RecoveryCodesLeft
                        </MudText>
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">
                            العمليات الحساسة التالية تتطلب إعادة تحقق كاملة: كلمة المرور الحالية + رمز جديد من تطبيق المصادقة أو رمز استرداد.
                        </MudAlert>

                        <MudText Typo="Typo.subtitle1" Class="mt-5">تجديد رموز الاسترداد</MudText>
                        <MudTextField T="string" Label="كلمة المرور الحالية"
                                      @bind-Value="ViewModel.MfaRecoveryCodes.CurrentPassword"
                                      InputType="InputType.Password" Variant="Variant.Outlined" Class="mt-3" />
                        <MudTextField T="string" Label="رمز MFA الحالي أو رمز استرداد"
                                      @bind-Value="ViewModel.MfaRecoveryCodes.Code"
                                      Variant="Variant.Outlined" Class="mt-3" />
                        <MudButton Color="Color.Secondary" Variant="Variant.Outlined"
                                   Disabled="ViewModel.IsBusy" OnClick="RegenerateRecoveryCodesAsync" Class="mt-3">
                            إنشاء رموز استرداد جديدة
                        </MudButton>

                        <MudText Typo="Typo.subtitle1" Class="mt-6">تعطيل المصادقة الثنائية</MudText>
                        <MudTextField T="string" Label="كلمة المرور الحالية"
                                      @bind-Value="ViewModel.MfaDisable.CurrentPassword"
                                      InputType="InputType.Password" Variant="Variant.Outlined" Class="mt-3" />
                        <MudTextField T="string" Label="رمز MFA الحالي أو رمز استرداد"
                                      @bind-Value="ViewModel.MfaDisable.Code"
                                      Variant="Variant.Outlined" Class="mt-3" />
                        <MudButton Color="Color.Error" Variant="Variant.Outlined"
                                   Disabled="ViewModel.IsBusy" OnClick="DisableMfaAsync" Class="mt-3">
                            تعطيل المصادقة الثنائية
                        </MudButton>
                    }
                    else
                    {
                        <MudTextField T="string" Label="كلمة المرور الحالية"
                                      @bind-Value="ViewModel.MfaSetupRequest.CurrentPassword"
                                      InputType="InputType.Password" Variant="Variant.Outlined" Class="mt-3" />
                        <MudButton Color="Color.Primary" Variant="Variant.Outlined"
                                   Disabled="ViewModel.IsBusy" OnClick="SetupMfaAsync" Class="mt-3">
                            إنشاء مفتاح المصادقة
                        </MudButton>

                        @if (ViewModel.MfaSetup is not null)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-4">
                                احفظ المفتاح في تطبيق مصادقة موثوق ولا تشاركه.
                            </MudAlert>
                            <MudTextField T="string" Label="المفتاح"
                                          Value="@ViewModel.MfaSetup.SharedKey" ReadOnly="true"
                                          Variant="Variant.Outlined" Class="mt-3" />
                            <MudTextField T="string" Label="Authenticator URI"
                                          Value="@ViewModel.MfaSetup.AuthenticatorUri" ReadOnly="true"
                                          Variant="Variant.Outlined" Class="mt-3" Lines="3" />
                            <MudTextField T="string" Label="رمز التطبيق"
                                          @bind-Value="ViewModel.MfaCode.Code"
                                          Variant="Variant.Outlined" Class="mt-3" />
                            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                                       Disabled="ViewModel.IsBusy" OnClick="EnableMfaAsync" Class="mt-3">
                                تفعيل المصادقة الثنائية
                            </MudButton>
                        }
                    }

                    @if (ViewModel.RecoveryCodes.Count > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mt-5">
                            هذه الرموز تُعرض هنا لتسليمها لك فقط. خزّنها خارج الجهاز بصورة آمنة؛ المجموعة الجديدة تبطل السابقة.
                        </MudAlert>
                        @foreach (var recoveryCode in ViewModel.RecoveryCodes)
                        {
                            <MudPaper Class="mt-2 pa-3" Elevation="0">
                                <code>@recoveryCode</code>
                            </MudPaper>
                        }
                    }
                </MudTabPanel>
            }
        </MudTabs>

        @if (!string.IsNullOrWhiteSpace(ViewModel.SuccessMessage))
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mt-5">
                @ViewModel.SuccessMessage
            </MudAlert>
        }
        @if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-5">
                @ViewModel.ErrorMessage
            </MudAlert>
        }
    </MudPaper>
</MudContainer>

@code {
    private MudForm? _loginForm;
    private MudForm? _registerForm;

    protected override void OnInitialized()
    {
        ViewModel.StateChanged += OnStateChanged;
        _ = ViewModel.LoadAsync();
    }

    private async Task LoginAsync()
    {
        if (_loginForm is null) return;
        await _loginForm.Validate();
        if (!_loginForm.IsValid) return;
        await ViewModel.LoginAsync();
        CompleteAuthentication();
    }

    private async Task TwoFactorAsync()
    {
        await ViewModel.CompleteTwoFactorLoginAsync();
        CompleteAuthentication();
    }

    private async Task RegisterAsync()
    {
        if (_registerForm is null) return;
        await _registerForm.Validate();
        if (!_registerForm.IsValid) return;
        await ViewModel.RegisterAsync();
        CompleteAuthentication();
    }

    private Task RequestConfirmationAsync() => ViewModel.RequestConfirmationAsync();
    private Task ConfirmEmailAsync() => ViewModel.ConfirmEmailAsync();
    private Task ForgotPasswordAsync() => ViewModel.ForgotPasswordAsync();
    private Task ResetPasswordAsync() => ViewModel.ResetPasswordAsync();
    private Task ChangePasswordAsync() => ViewModel.ChangePasswordAsync();
    private Task SetupMfaAsync() => ViewModel.SetupMfaAsync();
    private Task EnableMfaAsync() => ViewModel.EnableMfaAsync();
    private Task DisableMfaAsync() => ViewModel.DisableMfaAsync();
    private Task RegenerateRecoveryCodesAsync() => ViewModel.RegenerateRecoveryCodesAsync();

    private void CompleteAuthentication()
    {
        if (ViewModel.CurrentUser?.IsAuthenticated != true) return;
        Snackbar.Add($"مرحبًا {ViewModel.CurrentUser.DisplayName}", Severity.Success);
        Navigation.NavigateTo("/initiatives");
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ViewModel.StateChanged -= OnStateChanged;
    }
}
