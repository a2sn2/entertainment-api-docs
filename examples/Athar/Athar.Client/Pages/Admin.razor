@page "/admin"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = AtharRoles.Administrator)]
@implements IDisposable
@inject AdminViewModel ViewModel
@inject ISnackbar Snackbar

<PageTitle>لوحة الإدارة — منصة أثر</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-10">
    <div class="page-heading">
        <div>
            <div class="eyebrow">مساحة الإدارة</div>
            <MudText Typo="Typo.h2">مركز قرار المبادرات</MudText>
            <MudText Class="muted-copy mt-2">
                مؤشرات لحظية، تفاصيل مكتملة قبل القرار، وقائمة مراجعة مرتبطة بسجل تدقيق دائم.
            </MudText>
        </div>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="ViewModel.LoadAsync"
                   Disabled="ViewModel.IsBusy">
            تحديث
        </MudButton>
    </div>

    @if (ViewModel.Dashboard is not null)
    {
        <MudGrid Class="mt-6">
            <MudItem xs="6" md="3">
                <MudPaper Class="athar-card metric-card" Elevation="0">
                    <MudText Typo="Typo.h3">@ViewModel.Dashboard.Submitted</MudText>
                    <MudText>قيد المراجعة</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudPaper Class="athar-card metric-card" Elevation="0">
                    <MudText Typo="Typo.h3">@ViewModel.Dashboard.Approved</MudText>
                    <MudText>معتمدة</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudPaper Class="athar-card metric-card" Elevation="0">
                    <MudText Typo="Typo.h3">@ViewModel.Dashboard.ApprovedBeneficiaries.ToString("N0")</MudText>
                    <MudText>مستفيد مستهدف</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudPaper Class="athar-card metric-card" Elevation="0">
                    <MudText Typo="Typo.h3">@ViewModel.Dashboard.ApprovedBudget.ToString("N0")</MudText>
                    <MudText>ميزانية المبادرات المعتمدة</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }

    <MudGrid Class="mt-6">
        <MudItem xs="12" lg="5">
            <MudPaper Class="athar-card pa-6" Elevation="0">
                <div class="list-toolbar">
                    <div>
                        <MudText Typo="Typo.h4">قائمة المراجعة</MudText>
                        <MudText Class="muted-copy">اختر الحالة ثم افتح المبادرة.</MudText>
                    </div>
                    <MudSelect T="string"
                               Value="@ViewModel.Status"
                               ValueChanged="StatusChanged"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Style="min-width: 170px">
                        <MudSelectItem Value="@("submitted")">قيد المراجعة</MudSelectItem>
                        <MudSelectItem Value="@("approved")">المعتمدة</MudSelectItem>
                        <MudSelectItem Value="@("rejected")">المرفوضة</MudSelectItem>
                    </MudSelect>
                </div>

                @if (ViewModel.IsBusy && ViewModel.Items.Count == 0)
                {
                    <MudProgressLinear Indeterminate="true"
                                       Color="Color.Primary"
                                       Class="mt-5" />
                }
                else if (ViewModel.Items.Count == 0)
                {
                    <div class="empty-state compact-empty">
                        <MudIcon Icon="@Icons.Material.Filled.TaskAlt"
                                 Size="Size.Large"
                                 Color="Color.Success" />
                        <MudText Typo="Typo.h6">لا توجد عناصر في هذه القائمة</MudText>
                    </div>
                }
                else
                {
                    <div class="admin-grid mt-5">
                        @foreach (var item in ViewModel.Items)
                        {
                            <article class="admin-item @(ViewModel.Selected?.Id == item.Id ? "selected" : string.Empty)">
                                <button type="button"
                                        class="admin-item-header"
                                        disabled="@ViewModel.IsBusy"
                                        @onclick="() => ViewModel.SelectAsync(item.Id)">
                                    <span>
                                        <strong>@item.Title</strong>
                                        <small>@item.Category · @item.City</small>
                                    </span>
                                    <MudChip T="string"
                                             Variant="Variant.Outlined"
                                             Size="Size.Small"
                                             Color="@StatusColor(item.Status)">
                                        @StatusLabel(item.Status)
                                    </MudChip>
                                </button>
                            </article>
                        }
                    </div>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="7">
            <MudPaper Class="athar-card pa-6 admin-details-shell" Elevation="0">
                @if (ViewModel.Selected is null)
                {
                    <div class="empty-state">
                        <MudIcon Icon="@Icons.Material.Filled.FactCheck"
                                 Size="Size.Large"
                                 Color="Color.Primary" />
                        <MudText Typo="Typo.h5">اختر مبادرة للمراجعة</MudText>
                        <MudText Class="muted-copy">
                            ستظهر هنا كل البيانات التي يحتاجها المسؤول قبل اتخاذ القرار.
                        </MudText>
                    </div>
                }
                else
                {
                    var selected = ViewModel.Selected;
                    <section class="details-panel admin-details-panel">
                        <div class="details-heading">
                            <div>
                                <div class="eyebrow">طلب رقم @selected.Id</div>
                                <MudText Typo="Typo.h4">@selected.Title</MudText>
                                <MudText Typo="Typo.body2" Class="muted-copy mt-2">
                                    مقدّم المبادرة: @selected.OwnerDisplayName
                                </MudText>
                            </div>
                            <MudChip T="string"
                                     Color="@StatusColor(selected.Status)"
                                     Variant="Variant.Filled">
                                @StatusLabel(selected.Status)
                            </MudChip>
                        </div>

                        <MudText Class="details-summary mt-5">@selected.Summary</MudText>

                        <div class="details-grid mt-5">
                            <div><span>التصنيف</span><strong>@selected.Category</strong></div>
                            <div><span>المدينة</span><strong>@selected.City</strong></div>
                            <div><span>الميزانية المطلوبة</span><strong>@selected.RequestedBudget.ToString("N0")</strong></div>
                            <div><span>المستفيدون المتوقعون</span><strong>@selected.TargetBeneficiaries.ToString("N0")</strong></div>
                            <div><span>تاريخ الإرسال</span><strong>@selected.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</strong></div>
                            <div><span>آخر تحديث</span><strong>@selected.UpdatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</strong></div>
                        </div>

                        @if (selected.Reviews.Count > 0)
                        {
                            <MudDivider Class="my-5" />
                            <MudText Typo="Typo.h6">سجل القرارات</MudText>
                            <div class="review-history mt-3">
                                @foreach (var review in selected.Reviews)
                                {
                                    <article class="review-entry">
                                        <div class="review-entry-heading">
                                            <strong>@DecisionLabel(review.Decision)</strong>
                                            <span>@review.ReviewedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                        </div>
                                        <MudText Typo="Typo.body2">المراجع: @review.ReviewerDisplayName</MudText>
                                        <MudText Class="muted-copy mt-2">
                                            @(string.IsNullOrWhiteSpace(review.Notes) ? "لا توجد ملاحظات إضافية." : review.Notes)
                                        </MudText>
                                    </article>
                                }
                            </div>
                        }

                        @if (selected.Status == InitiativeWorkflow.Submitted)
                        {
                            <MudDivider Class="my-5" />
                            <MudText Typo="Typo.h6">قرار الإدارة</MudText>
                            <MudTextField T="string"
                                          Label="ملاحظات القرار"
                                          HelperText="اشرح سبب القرار بلغة واضحة ليظهر للمستخدم."
                                          @bind-Value="_reviewNotes"
                                          Lines="4"
                                          Variant="Variant.Outlined"
                                          Class="mt-3" />
                            <MudStack Row="true" Spacing="2" Class="mt-4 flex-wrap">
                                <MudButton Color="Color.Success"
                                           Variant="Variant.Filled"
                                           Disabled="ViewModel.IsBusy"
                                           StartIcon="@Icons.Material.Filled.CheckCircle"
                                           OnClick="@(() => ReviewAsync(selected.Id, InitiativeWorkflow.Approve))">
                                    اعتماد المبادرة
                                </MudButton>
                                <MudButton Color="Color.Error"
                                           Variant="Variant.Outlined"
                                           Disabled="ViewModel.IsBusy"
                                           StartIcon="@Icons.Material.Filled.Cancel"
                                           OnClick="@(() => ReviewAsync(selected.Id, InitiativeWorkflow.Reject))">
                                    رفض المبادرة
                                </MudButton>
                            </MudStack>
                        }
                    </section>
                }

                @if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
                {
                    <MudAlert Severity="Severity.Error"
                              Variant="Variant.Outlined"
                              Class="mt-5">
                        @ViewModel.ErrorMessage
                    </MudAlert>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private string? _reviewNotes;

    protected override async Task OnInitializedAsync()
    {
        ViewModel.StateChanged += OnStateChanged;
        await ViewModel.LoadAsync();
    }

    private async Task StatusChanged(string status)
    {
        ViewModel.Status = status;
        _reviewNotes = null;
        await ViewModel.LoadAsync();
    }

    private async Task ReviewAsync(Guid id, string decision)
    {
        await ViewModel.ReviewAsync(id, decision, _reviewNotes);
        if (string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
        {
            Snackbar.Add(
                decision == InitiativeWorkflow.Approve
                    ? "تم اعتماد المبادرة وحفظ سجل القرار."
                    : "تم رفض المبادرة وحفظ سجل القرار.",
                Severity.Success);
            _reviewNotes = null;
        }
    }

    private static Color StatusColor(string status) =>
        status switch
        {
            InitiativeWorkflow.Approved => Color.Success,
            InitiativeWorkflow.Rejected => Color.Error,
            _ => Color.Warning
        };

    private static string StatusLabel(string status) =>
        status switch
        {
            InitiativeWorkflow.Approved => "معتمدة",
            InitiativeWorkflow.Rejected => "مرفوضة",
            _ => "قيد المراجعة"
        };

    private static string DecisionLabel(string decision) =>
        decision == InitiativeWorkflow.Approve
            ? "اعتماد"
            : "رفض";

    private void OnStateChanged() =>
        _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ViewModel.StateChanged -= OnStateChanged;
    }
}
