<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <MudContainer MaxWidth="MaxWidth.Small" Class="py-16">
                        <MudPaper Class="pa-8 athar-card" Elevation="0">
                            <MudText Typo="Typo.h4">هذه الصفحة تحتاج تسجيل الدخول</MudText>
                            <MudText Class="mt-3 muted-copy">
                                سجّل الدخول للمتابعة، أو ارجع إلى الصفحة الرئيسية.
                            </MudText>
                            <MudStack Row="true" Spacing="2" Class="mt-6">
                                <MudButton Href="/account" Color="Color.Primary" Variant="Variant.Filled">
                                    تسجيل الدخول
                                </MudButton>
                                <MudButton Href="/" Variant="Variant.Outlined">
                                    الرئيسية
                                </MudButton>
                            </MudStack>
                        </MudPaper>
                    </MudContainer>
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <MudContainer Class="py-16">
                    <MudText Typo="Typo.h3">الصفحة غير موجودة</MudText>
                    <MudButton Href="/" Class="mt-4">العودة للرئيسية</MudButton>
                </MudContainer>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
