<Project>
  <!--
    Directory.Build.props discovery stops at the nearest file. Import the repository
    baseline explicitly so test projects keep the shared TargetFramework, nullable,
    analyzers, deterministic-build, and NuGet-audit settings.
  -->
  <Import Project="$(MSBuildThisFileDirectory)../Directory.Build.props" />

  <PropertyGroup>
    <!--
      xUnit tests intentionally use behavior-oriented underscore-separated names
      because they read as executable specifications in CI. CA1707 is a public API
      naming rule and does not improve security or package compatibility for tests.
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
</Project>
