@page "/admin/departments"
@attribute [Authorize(Roles = "Administrator")]
@inject MadarApiClient ApiClient

<PageTitle>إدارة الأقسام | مدار</PageTitle>

<MudStack Spacing="4" dir="rtl">
    <div>
        <MudText Typo="Typo.h3">إدارة الأقسام</MudText>
        <MudText Typo="Typo.body1">
            أنشئ الأقسام التشغيلية واضبط حالتها وعضوية موظفي Operator دون تغيير نموذج الصلاحيات العام.
        </MudText>
    </div>

    @if (!string.IsNullOrWhiteSpace(_pageError))
    {
        <MudAlert Severity="Severity.Error">@_pageError</MudAlert>
    }

    <MudPaper Elevation="0" Outlined="true" Class="pa-6">
        <MudText Typo="Typo.h5" GutterBottom="true">قسم جديد</MudText>
        @if (!string.IsNullOrWhiteSpace(_createError))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_createError</MudAlert>
        }

        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTextField T="string"
                              Label="الرمز الثابت"
                              Variant="Variant.Outlined"
                              @bind-Value="_newCode"
                              Disabled="_creating" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string"
                              Label="اسم القسم"
                              Variant="Variant.Outlined"
                              @bind-Value="_newName"
                              Disabled="_creating" />
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex align-center">
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           FullWidth="true"
                           Disabled="_creating"
                           OnClick="CreateAsync">
                    @(_creating ? "جارٍ الإنشاء..." : "إنشاء")
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Outlined="true" Class="pa-6">
                    <MudText Typo="Typo.h5" GutterBottom="true">الأقسام</MudText>
                    @if (_departments.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info">لا توجد أقسام مسجلة.</MudAlert>
                    }
                    else
                    {
                        <MudTable Items="_departments" Hover="true" Dense="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>الرمز</MudTh>
                                <MudTh>الاسم</MudTh>
                                <MudTh>الحالة</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate Context="item">
                                <MudTd DataLabel="الرمز">@item.Code</MudTd>
                                <MudTd DataLabel="الاسم">@item.Name</MudTd>
                                <MudTd DataLabel="الحالة">@(item.IsActive ? "نشط" : "معطل")</MudTd>
                                <MudTd>
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Text"
                                               OnClick="@(() => SelectDepartmentAsync(item))">
                                        إدارة
                                    </MudButton>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                @if (_selectedDepartment is null)
                {
                    <MudAlert Severity="Severity.Info">
                        اختر قسمًا من القائمة لإدارة بياناته وعضوياته.
                    </MudAlert>
                }
                else
                {
                    <MudStack Spacing="4">
                        <MudPaper Elevation="0" Outlined="true" Class="pa-6">
                            <MudText Typo="Typo.h5" GutterBottom="true">بيانات القسم</MudText>
                            <MudText Typo="Typo.caption" Class="d-block mb-4">
                                الرمز @_selectedDepartment.Code ثابت ولا يتغير بعد الإنشاء.
                            </MudText>

                            @if (!string.IsNullOrWhiteSpace(_editError))
                            {
                                <MudAlert Severity="Severity.Error" Class="mb-4">@_editError</MudAlert>
                            }

                            <MudTextField T="string"
                                          Label="اسم القسم"
                                          Variant="Variant.Outlined"
                                          @bind-Value="_editName"
                                          Disabled="_saving" />
                            <MudSwitch T="bool"
                                       @bind-Value="_editActive"
                                       Label="القسم نشط"
                                       Disabled="_saving"
                                       Class="mt-3" />
                            <MudButton Color="Color.Primary"
                                       Variant="Variant.Filled"
                                       Disabled="_saving"
                                       OnClick="SaveAsync"
                                       Class="mt-4">
                                @(_saving ? "جارٍ الحفظ..." : "حفظ التعديلات")
                            </MudButton>
                        </MudPaper>

                        <MudPaper Elevation="0" Outlined="true" Class="pa-6">
                            <MudText Typo="Typo.h5" GutterBottom="true">عضوية الموظفين</MudText>
                            @if (!string.IsNullOrWhiteSpace(_memberError))
                            {
                                <MudAlert Severity="Severity.Error" Class="mb-4">@_memberError</MudAlert>
                            }

                            <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2" Class="mb-4">
                                <MudSelect T="Guid?"
                                           Label="إضافة موظف Operator"
                                           Variant="Variant.Outlined"
                                           @bind-Value="_selectedOperatorId"
                                           Disabled="_memberBusy"
                                           Style="min-width: 260px;">
                                    @foreach (var option in AvailableOperators)
                                    {
                                        <MudSelectItem T="Guid?" Value="@((Guid?)option.UserId)">
                                            @option.DisplayName (@option.Email)
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                                <MudButton Color="Color.Primary"
                                           Variant="Variant.Filled"
                                           Disabled="_memberBusy || !_selectedOperatorId.HasValue"
                                           OnClick="AddMemberAsync">
                                    إضافة
                                </MudButton>
                            </MudStack>

                            @if (_membersLoading)
                            {
                                <MudProgressLinear Indeterminate="true" />
                            }
                            else if (_members.Count == 0)
                            {
                                <MudAlert Severity="Severity.Info">لا توجد عضويات في هذا القسم.</MudAlert>
                            }
                            else
                            {
                                <MudTable Items="_members" Dense="true" Hover="true" Elevation="0">
                                    <HeaderContent>
                                        <MudTh>الموظف</MudTh>
                                        <MudTh>البريد</MudTh>
                                        <MudTh>تاريخ الانضمام</MudTh>
                                        <MudTh></MudTh>
                                    </HeaderContent>
                                    <RowTemplate Context="member">
                                        <MudTd DataLabel="الموظف">@member.DisplayName</MudTd>
                                        <MudTd DataLabel="البريد">@member.Email</MudTd>
                                        <MudTd DataLabel="تاريخ الانضمام">@member.JoinedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                                        <MudTd>
                                            <MudButton Size="Size.Small"
                                                       Color="Color.Error"
                                                       Variant="Variant.Text"
                                                       Disabled="_memberBusy"
                                                       OnClick="@(() => RemoveMemberAsync(member.UserId))">
                                                إزالة
                                            </MudButton>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        </MudPaper>
                    </MudStack>
                }
            </MudItem>
        </MudGrid>
    }
</MudStack>

@code {
    private readonly List<DepartmentAdminDto> _departments = [];
    private readonly List<DepartmentMemberDto> _members = [];
    private readonly List<OperatorOptionDto> _operators = [];
    private DepartmentAdminDto? _selectedDepartment;
    private bool _loading = true;
    private bool _creating;
    private bool _saving;
    private bool _membersLoading;
    private bool _memberBusy;
    private string? _pageError;
    private string? _createError;
    private string? _editError;
    private string? _memberError;
    private string _newCode = string.Empty;
    private string _newName = string.Empty;
    private string _editName = string.Empty;
    private bool _editActive = true;
    private Guid? _selectedOperatorId;

    private IEnumerable<OperatorOptionDto> AvailableOperators =>
        _operators.Where(option =>
            _members.All(member => member.UserId != option.UserId));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _pageError = null;
        try
        {
            var departmentsResult = await ApiClient.ListAdminDepartmentsAsync();
            if (departmentsResult.IsFailure || departmentsResult.Value is null)
            {
                _pageError = departmentsResult.Error ?? "تعذر تحميل الأقسام.";
                return;
            }

            _departments.Clear();
            _departments.AddRange(departmentsResult.Value);

            var operatorsResult = await ApiClient.GetOperatorsAsync();
            _operators.Clear();
            if (operatorsResult.IsSuccess && operatorsResult.Value is not null)
                _operators.AddRange(operatorsResult.Value);

            if (_selectedDepartment is not null)
            {
                var refreshed = _departments.FirstOrDefault(item =>
                    item.Id == _selectedDepartment.Id);
                if (refreshed is null)
                {
                    _selectedDepartment = null;
                    _members.Clear();
                }
                else
                {
                    await SelectDepartmentAsync(refreshed);
                }
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateAsync()
    {
        if (_creating)
            return;

        _creating = true;
        _createError = null;
        try
        {
            var result = await ApiClient.CreateDepartmentAsync(
                new CreateDepartmentRequest(_newCode, _newName));
            if (result.IsFailure || result.Value is null)
            {
                _createError = result.Error ?? "تعذر إنشاء القسم.";
                return;
            }

            _newCode = string.Empty;
            _newName = string.Empty;
            await LoadAsync();
            var created = _departments.FirstOrDefault(item =>
                item.Id == result.Value.Id);
            if (created is not null)
                await SelectDepartmentAsync(created);
        }
        finally
        {
            _creating = false;
        }
    }

    private async Task SelectDepartmentAsync(DepartmentAdminDto department)
    {
        _selectedDepartment = department;
        _editName = department.Name;
        _editActive = department.IsActive;
        _editError = null;
        _memberError = null;
        _selectedOperatorId = null;
        await LoadMembersAsync();
    }

    private async Task SaveAsync()
    {
        if (_selectedDepartment is null || _saving)
            return;

        _saving = true;
        _editError = null;
        try
        {
            var result = await ApiClient.UpdateDepartmentAsync(
                _selectedDepartment.Id,
                new UpdateDepartmentRequest(_editName, _editActive));
            if (result.IsFailure || result.Value is null)
            {
                _editError = result.Error ?? "تعذر تحديث القسم.";
                return;
            }

            _selectedDepartment = result.Value;
            _editName = result.Value.Name;
            _editActive = result.Value.IsActive;
            var index = _departments.FindIndex(item => item.Id == result.Value.Id);
            if (index >= 0)
                _departments[index] = result.Value;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task LoadMembersAsync()
    {
        _members.Clear();
        if (_selectedDepartment is null)
            return;

        _membersLoading = true;
        try
        {
            var result = await ApiClient.ListDepartmentMembersAsync(
                _selectedDepartment.Id);
            if (result.IsFailure || result.Value is null)
            {
                _memberError = result.Error ?? "تعذر تحميل عضويات القسم.";
                return;
            }

            _members.AddRange(result.Value);
        }
        finally
        {
            _membersLoading = false;
        }
    }

    private async Task AddMemberAsync()
    {
        if (_selectedDepartment is null
            || !_selectedOperatorId.HasValue
            || _memberBusy)
        {
            return;
        }

        _memberBusy = true;
        _memberError = null;
        try
        {
            var result = await ApiClient.AddDepartmentMemberAsync(
                _selectedDepartment.Id,
                new AddDepartmentMemberRequest(_selectedOperatorId.Value));
            if (result.IsFailure)
            {
                _memberError = result.Error ?? "تعذر إضافة الموظف إلى القسم.";
                return;
            }

            _selectedOperatorId = null;
            await LoadMembersAsync();
        }
        finally
        {
            _memberBusy = false;
        }
    }

    private async Task RemoveMemberAsync(Guid userId)
    {
        if (_selectedDepartment is null || _memberBusy)
            return;

        _memberBusy = true;
        _memberError = null;
        try
        {
            var result = await ApiClient.RemoveDepartmentMemberAsync(
                _selectedDepartment.Id,
                userId);
            if (result.IsFailure)
            {
                _memberError = result.Error ?? "تعذر إزالة الموظف من القسم.";
                return;
            }

            await LoadMembersAsync();
        }
        finally
        {
            _memberBusy = false;
        }
    }
}
