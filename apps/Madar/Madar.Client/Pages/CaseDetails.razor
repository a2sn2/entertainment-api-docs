@page "/cases/{CaseId:guid}"
@attribute [Authorize]
@using Madar.Client.Components
@inject MadarApiClient ApiClient

<PageTitle>تفاصيل الحالة | مدار</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_case is not null)
{
    <MudStack Spacing="4" dir="rtl">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.h3">@_case.Title</MudText>
                <MudText Typo="Typo.body2">@_case.Id.ToString("D")</MudText>
            </div>
            <MudSpacer />
            <MudButton Href="/cases" Variant="Variant.Outlined">العودة للحالات</MudButton>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(_actionError))
        {
            <MudAlert Severity="Severity.Error">@_actionError</MudAlert>
        }

        @if (_case.SlaState == "breached")
        {
            <MudAlert Severity="Severity.Warning">
                تم تجاوز مهلة SLA لهذه الحالة.
                @if (_case.EscalatedUtc.HasValue)
                {
                    <span> سُجل التصعيد في @_case.EscalatedUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss").</span>
                }
            </MudAlert>
        }

        <MudPaper Elevation="0" Outlined="true" Class="pa-6">
            <MudGrid>
                <MudItem xs="12" md="8">
                    <MudText Typo="Typo.overline">الوصف</MudText>
                    <MudText Typo="Typo.body1">@_case.Description</MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudStack Spacing="2">
                        <MudText><b>الحالة:</b> @DisplayStatus(_case.Status)</MudText>
                        <MudText><b>النوع:</b> @DisplayCaseType(_case.CaseType)</MudText>
                        <MudText><b>الأولوية:</b> @DisplayPriority(_case.Priority)</MudText>
                        <MudText><b>القسم:</b> @DisplayDepartment(_case.DepartmentId)</MudText>
                        <MudText><b>وقت التوجيه:</b> @DisplayUtc(_case.RoutedUtc)</MudText>
                        <MudText><b>SLA:</b> @DisplaySlaState(_case.SlaState)</MudText>
                        <MudText><b>هدف SLA:</b> @DisplayUtc(_case.SlaTargetUtc)</MudText>
                        <MudText><b>وقت الخرق:</b> @DisplayUtc(_case.SlaBreachedUtc)</MudText>
                        <MudText><b>وقت التصعيد:</b> @DisplayUtc(_case.EscalatedUtc)</MudText>
                        <MudText><b>المنشئ:</b> @_case.CreatedByUserId.ToString("D")</MudText>
                        <MudText><b>المسند إليه:</b> @(_case.AssignedToUserId?.ToString("D") ?? "غير مسندة")</MudText>
                        <MudText><b>أُنشئت:</b> @_case.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudText>
                        <MudText><b>آخر تحديث:</b> @_case.UpdatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudText>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <AuthorizeView Roles="Supervisor,Administrator">
            <Authorized>
                @if (_case.Status == "new" && !_case.DepartmentId.HasValue)
                {
                    <MudPaper Elevation="0" Outlined="true" Class="pa-6">
                        <MudText Typo="Typo.h5" GutterBottom="true">توجيه الحالة</MudText>
                        <MudText Typo="Typo.body2" Class="mb-3">
                            التوجيه يضع الحالة في قائمة انتظار القسم مع بقائها جديدة حتى يتم استلامها أو إسنادها.
                        </MudText>
                        @if (_departments.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info">لا توجد أقسام تشغيلية فعالة متاحة للتوجيه.</MudAlert>
                        }
                        else
                        {
                            <MudSelect T="Guid?"
                                       Label="القسم"
                                       Variant="Variant.Outlined"
                                       @bind-Value="_selectedDepartmentId"
                                       Disabled="_acting">
                                @foreach (var department in _departments)
                                {
                                    <MudSelectItem T="Guid?" Value="@((Guid?)department.Id)">@department.Name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudButton Color="Color.Primary"
                                       Variant="Variant.Outlined"
                                       Disabled="_acting || !_selectedDepartmentId.HasValue"
                                       OnClick="RouteAsync"
                                       Class="mt-4">
                                توجيه للقسم
                            </MudButton>
                        }
                    </MudPaper>

                    <MudPaper Elevation="0" Outlined="true" Class="pa-6">
                        <MudText Typo="Typo.h5" GutterBottom="true">إسناد الحالة</MudText>
                        @if (_case.DepartmentId.HasValue)
                        {
                            <MudAlert Severity="Severity.Info" Class="mb-3">
                                الحالة موجهة إلى قسم؛ يقبل النظام الإسناد فقط لموظف Operator عضو في هذا القسم.
                            </MudAlert>
                        }
                        @if (_operators.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info">لا يوجد موظفون بدور Operator متاحون للإسناد.</MudAlert>
                        }
                        else
                        {
                            <MudSelect T="string"
                                       Label="الموظف"
                                       Variant="Variant.Outlined"
                                       @bind-Value="_selectedOperatorId"
                                       Disabled="_acting">
                                @foreach (var item in _operators)
                                {
                                    <MudSelectItem T="string" Value="@item.UserId.ToString("D")">
                                        @item.DisplayName (@item.Email)
                                    </MudSelectItem>
                                }
                            </MudSelect>
                            <MudButton Color="Color.Primary"
                                       Variant="Variant.Filled"
                                       Disabled="_acting || string.IsNullOrWhiteSpace(_selectedOperatorId)"
                                       OnClick="AssignAsync"
                                       Class="mt-4">
                                إسناد
                            </MudButton>
                        }
                    </MudPaper>
                }

                @if (_case.DepartmentId.HasValue
                    && _case.Status is "new" or "assigned" or "in-progress")
                {
                    <MudPaper Elevation="0" Outlined="true" Class="pa-6">
                        <MudText Typo="Typo.h5" GutterBottom="true">نقل الحالة إلى قسم آخر</MudText>
                        <MudText Typo="Typo.body2" Class="mb-3">
                            النقل يعيد الحالة إلى قائمة انتظار القسم الجديد ويلغي الإسناد الحالي، مع بقاء SLA والتعليقات والاعتمادات والسجل محفوظة.
                        </MudText>
                        @if (_departments.All(item => item.Id == _case.DepartmentId.Value))
                        {
                            <MudAlert Severity="Severity.Info">لا يوجد قسم آخر فعال متاح للنقل.</MudAlert>
                        }
                        else
                        {
                            <MudSelect T="Guid?"
                                       Label="القسم الجديد"
                                       Variant="Variant.Outlined"
                                       @bind-Value="_selectedTransferDepartmentId"
                                       Disabled="_acting">
                                @foreach (var department in _departments.Where(item => item.Id != _case.DepartmentId.Value))
                                {
                                    <MudSelectItem T="Guid?" Value="@((Guid?)department.Id)">@department.Name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudButton Color="Color.Warning"
                                       Variant="Variant.Outlined"
                                       Disabled="_acting || !_selectedTransferDepartmentId.HasValue"
                                       OnClick="TransferAsync"
                                       Class="mt-4">
                                نقل الحالة
                            </MudButton>
                        }
                    </MudPaper>
                }

                @if (_case.Status is "assigned" or "in-progress")
                {
                    <MudPaper Elevation="0" Outlined="true" Class="pa-6">
                        <MudText Typo="Typo.h5" GutterBottom="true">إعادة إسناد الحالة</MudText>
                        <MudText Typo="Typo.body2" Class="mb-3">
                            إعادة الإسناد تحافظ على حالة المعالجة وSLA. إذا كانت الحالة موجهة إلى قسم فيجب أن يكون الموظف الجديد عضوًا فيه.
                        </MudText>
                        @if (_operators.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info">لا يوجد موظفون بدور Operator متاحون.</MudAlert>
                        }
                        else
                        {
                            <MudSelect T="string"
                                       Label="الموظف الجديد"
                                       Variant="Variant.Outlined"
                                       @bind-Value="_selectedOperatorId"
                                       Disabled="_acting">
                                @foreach (var item in _operators.Where(item => item.UserId != _case.AssignedToUserId))
                                {
                                    <MudSelectItem T="string" Value="@item.UserId.ToString("D")">
                                        @item.DisplayName (@item.Email)
                                    </MudSelectItem>
                                }
                            </MudSelect>
                            <MudButton Color="Color.Warning"
                                       Variant="Variant.Filled"
                                       Disabled="_acting || string.IsNullOrWhiteSpace(_selectedOperatorId)"
                                       OnClick="ReassignAsync"
                                       Class="mt-4">
                                إعادة الإسناد
                            </MudButton>
                        }
                    </MudPaper>
                }
            </Authorized>
        </AuthorizeView>

        @if (_case.Status == "new" && _case.DepartmentId.HasValue)
        {
            <AuthorizeView Roles="Operator">
                <Authorized>
                    <MudPaper Elevation="0" Outlined="true" Class="pa-6">
                        <MudText Typo="Typo.h5" GutterBottom="true">استلام الحالة</MudText>
                        <MudText Typo="Typo.body2" Class="mb-3">
                            إذا كنت عضوًا في القسم الموجهة إليه الحالة يمكنك استلامها؛ عند النجاح تصبح الحالة مسندة إليك.
                        </MudText>
                        <MudButton Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   Disabled="_acting"
                                   OnClick="ClaimAsync">
                            استلام من قائمة الانتظار
                        </MudButton>
                    </MudPaper>
                </Authorized>
            </AuthorizeView>
        }

        <CaseApprovalPanel Case="_case" />

        <MudPaper Elevation="0" Outlined="true" Class="pa-6">
            <MudText Typo="Typo.h5" GutterBottom="true">الإجراء التالي</MudText>
            @if (_case.Status == "assigned")
            {
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           Disabled="_acting"
                           OnClick="StartProgressAsync">
                    بدء المعالجة
                </MudButton>
            }
            else if (_case.Status == "in-progress")
            {
                <MudButton Color="Color.Success"
                           Variant="Variant.Filled"
                           Disabled="_acting"
                           OnClick="ResolveAsync">
                    تسجيل الحل
                </MudButton>
                @if (_case.CaseType is "access-request" or "compliance-case")
                {
                    <MudText Typo="Typo.caption" Class="d-block mt-2">
                        يتطلب هذا النوع اعتماد آخر طلب قبل تسجيل الحل.
                    </MudText>
                }
            }
            else if (_case.Status == "resolved")
            {
                <AuthorizeView Roles="Supervisor,Administrator">
                    <Authorized>
                        <MudButton Color="Color.Success"
                                   Variant="Variant.Filled"
                                   Disabled="_acting"
                                   OnClick="CloseAsync">
                            إغلاق الحالة
                        </MudButton>
                    </Authorized>
                    <NotAuthorized>
                        <MudAlert Severity="Severity.Info">بانتظار المشرف لإغلاق الحالة.</MudAlert>
                    </NotAuthorized>
                </AuthorizeView>
            }
            else if (_case.Status == "closed")
            {
                <MudAlert Severity="Severity.Success">الحالة مغلقة ولا توجد إجراءات إضافية على دورة المعالجة الحالية.</MudAlert>
            }
            else if (_case.DepartmentId.HasValue)
            {
                <MudAlert Severity="Severity.Info">الحالة في قائمة انتظار القسم وتنتظر الاستلام أو الإسناد.</MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Info">يجب توجيه الحالة أو إسنادها قبل بدء المعالجة.</MudAlert>
            }
        </MudPaper>

        <CaseCommentsPanel CaseId="CaseId" />

        <MudPaper Elevation="0" Outlined="true" Class="pa-6">
            <MudText Typo="Typo.h5" GutterBottom="true">السجل الزمني</MudText>
            @if (_timeline.Count == 0)
            {
                <MudText Typo="Typo.body2">لا توجد أحداث مسجلة.</MudText>
            }
            else
            {
                <MudTable Items="_timeline" Dense="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>الوقت</MudTh>
                        <MudTh>الحدث</MudTh>
                        <MudTh>المنفذ</MudTh>
                        <MudTh>التفاصيل</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="entry">
                        <MudTd>@entry.OccurredAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
                        <MudTd>@DisplayTimelineAction(entry.Action)</MudTd>
                        <MudTd>@(entry.ActorId ?? "النظام")</MudTd>
                        <MudTd>@DisplayAttributes(entry.Attributes)</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    </MudStack>
}

@code {
    [Parameter]
    public Guid CaseId { get; set; }

    private readonly List<CaseTimelineEntryDto> _timeline = [];
    private readonly List<OperatorOptionDto> _operators = [];
    private readonly List<DepartmentDto> _departments = [];
    private CaseDto? _case;
    private bool _loading = true;
    private bool _acting;
    private string? _error;
    private string? _actionError;
    private string? _selectedOperatorId;
    private Guid? _selectedDepartmentId;
    private Guid? _selectedTransferDepartmentId;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var caseResult = await ApiClient.GetCaseAsync(CaseId);
            if (caseResult.IsFailure || caseResult.Value is null)
            {
                _error = caseResult.Error ?? "تعذر تحميل الحالة.";
                return;
            }

            _case = caseResult.Value;
            _selectedDepartmentId = _case.DepartmentId;
            _selectedTransferDepartmentId = null;
            _selectedOperatorId = null;
            await LoadTimelineAsync();

            var departmentsResult = await ApiClient.ListDepartmentsAsync();
            _departments.Clear();
            if (departmentsResult.IsSuccess && departmentsResult.Value is not null)
            {
                _departments.AddRange(departmentsResult.Value);
                _selectedDepartmentId ??= _departments.FirstOrDefault()?.Id;
            }

            var operatorsResult = await ApiClient.GetOperatorsAsync();
            _operators.Clear();
            if (operatorsResult.IsSuccess && operatorsResult.Value is not null)
                _operators.AddRange(operatorsResult.Value);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadTimelineAsync()
    {
        var result = await ApiClient.GetTimelineAsync(CaseId);
        _timeline.Clear();
        if (result.IsSuccess && result.Value is not null)
            _timeline.AddRange(result.Value);
    }

    private async Task RouteAsync()
    {
        if (!_selectedDepartmentId.HasValue)
        {
            _actionError = "اختر قسمًا صالحًا للتوجيه.";
            return;
        }

        await RunActionAsync(() => ApiClient.RouteCaseAsync(
            CaseId,
            new RouteCaseRequest(_selectedDepartmentId.Value)));
    }

    private async Task TransferAsync()
    {
        if (!_selectedTransferDepartmentId.HasValue)
        {
            _actionError = "اختر قسمًا جديدًا لنقل الحالة.";
            return;
        }

        await RunActionAsync(() => ApiClient.TransferCaseAsync(
            CaseId,
            new TransferCaseRequest(_selectedTransferDepartmentId.Value)));
        _selectedTransferDepartmentId = null;
        _selectedOperatorId = null;
    }

    private Task ClaimAsync() =>
        RunActionAsync(() => ApiClient.ClaimCaseAsync(CaseId));

    private async Task AssignAsync()
    {
        if (!Guid.TryParse(_selectedOperatorId, out var userId))
        {
            _actionError = "اختر موظفًا صالحًا للإسناد.";
            return;
        }

        await RunActionAsync(() =>
            ApiClient.AssignCaseAsync(CaseId, new AssignCaseRequest(userId)));
    }

    private async Task ReassignAsync()
    {
        if (!Guid.TryParse(_selectedOperatorId, out var userId))
        {
            _actionError = "اختر موظفًا جديدًا صالحًا للإسناد.";
            return;
        }

        await RunActionAsync(() =>
            ApiClient.ReassignCaseAsync(CaseId, new ReassignCaseRequest(userId)));
        _selectedOperatorId = null;
    }

    private Task StartProgressAsync() =>
        RunActionAsync(() => ApiClient.TransitionCaseAsync(
            CaseId,
            new TransitionCaseRequest("start-progress")));

    private Task ResolveAsync() =>
        RunActionAsync(() => ApiClient.TransitionCaseAsync(
            CaseId,
            new TransitionCaseRequest("resolve")));

    private Task CloseAsync() =>
        RunActionAsync(() => ApiClient.TransitionCaseAsync(
            CaseId,
            new TransitionCaseRequest("close")));

    private async Task RunActionAsync(Func<Task<FoundationKit.Blazor.Api.ApiResult<CaseDto>>> action)
    {
        if (_acting)
            return;

        _acting = true;
        _actionError = null;
        try
        {
            var result = await action();
            if (result.IsFailure || result.Value is null)
            {
                _actionError = result.Error ?? "تعذر تنفيذ العملية.";
                return;
            }

            _case = result.Value;
            _selectedDepartmentId = _case.DepartmentId ?? _selectedDepartmentId;
            await LoadTimelineAsync();
        }
        finally
        {
            _acting = false;
        }
    }

    private string DisplayDepartment(Guid? departmentId)
    {
        if (!departmentId.HasValue)
            return "غير موجهة";

        return _departments.FirstOrDefault(item => item.Id == departmentId.Value)?.Name
            ?? departmentId.Value.ToString("D");
    }

    private static string DisplayCaseType(string value) => value switch
    {
        "customer-complaint" => "شكوى عميل",
        "operational-incident" => "حادث تشغيلي",
        "internal-service-request" => "طلب خدمة داخلي",
        "access-request" => "طلب صلاحية",
        "compliance-case" => "حالة امتثال",
        "technical-escalation" => "تصعيد تقني",
        "operational-exception" => "استثناء تشغيلي",
        _ => value
    };

    private static string DisplayPriority(string value) => value switch
    {
        "low" => "منخفضة",
        "medium" => "متوسطة",
        "high" => "عالية",
        "critical" => "حرجة",
        _ => value
    };

    private static string DisplayStatus(string value) => value switch
    {
        "new" => "جديدة",
        "assigned" => "مسندة",
        "in-progress" => "قيد المعالجة",
        "resolved" => "تم الحل",
        "closed" => "مغلقة",
        _ => value
    };

    private static string DisplaySlaState(string value) => value switch
    {
        "not-applicable" => "غير مفعّل",
        "active" => "ضمن المهلة",
        "met" => "تم ضمن المهلة",
        "breached" => "متجاوز",
        _ => value
    };

    private static string DisplayTimelineAction(string value) => value switch
    {
        "madar.case.created" => "إنشاء الحالة",
        "madar.case.routed" => "توجيه الحالة إلى قسم",
        "madar.case.transferred" => "نقل الحالة إلى قسم آخر",
        "madar.case.claimed" => "استلام الحالة من قائمة الانتظار",
        "madar.case.assigned" => "إسناد الحالة",
        "madar.case.reassigned" => "إعادة إسناد الحالة",
        "madar.case.transitioned" => "تغيير الحالة",
        "madar.case.sla-breached" => "تجاوز SLA وتصعيد الحالة",
        "madar.case.comment-added" => "إضافة تعليق",
        "madar.case.approval-requested" => "طلب اعتماد الحالة",
        "madar.case.approval-decided" => "قرار اعتماد الحالة",
        "madar.case.notification-delivery" => "محاولة إرسال إشعار",
        _ => value
    };

    private static string DisplayUtc(DateTimeOffset? value) =>
        value.HasValue
            ? value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
            : "—";

    private static string DisplayAttributes(IReadOnlyDictionary<string, string> attributes) =>
        attributes.Count == 0
            ? "—"
            : string.Join("، ", attributes.Select(pair => $"{pair.Key}: {pair.Value}"));
}
