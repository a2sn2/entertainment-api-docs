@page "/"
@attribute [AllowAnonymous]

<PageTitle>مدار</PageTitle>

<MudPaper Elevation="0" Outlined="true" Class="pa-8" dir="rtl">
    <MudText Typo="Typo.h3" GutterBottom="true">مدار</MudText>
    <MudText Typo="Typo.h6" GutterBottom="true">منصة إدارة الحالات والعمليات</MudText>
    <MudText Typo="Typo.body1" Class="mb-6">
        الشريحة الرأسية الأولى تربط تسجيل الدخول وإنشاء الحالة والإسناد والمعالجة والإغلاق بسجل تدقيق قابل للتتبع.
    </MudText>

    <AuthorizeView>
        <Authorized>
            <MudButton Href="/cases" Color="Color.Primary" Variant="Variant.Filled">
                فتح الحالات
            </MudButton>
        </Authorized>
        <NotAuthorized>
            <MudButton Href="/login" Color="Color.Primary" Variant="Variant.Filled">
                تسجيل الدخول
            </MudButton>
        </NotAuthorized>
    </AuthorizeView>
</MudPaper>
