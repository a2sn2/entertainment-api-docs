@page "/cases"
@attribute [Authorize]
@inject MadarApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>الحالات | مدار</PageTitle>

<MudStack Spacing="4" dir="rtl">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <div>
            <MudText Typo="Typo.h3">الحالات التشغيلية</MudText>
            <MudText Typo="Typo.body1">أنشئ حالة وتابع التوجيه والإسناد ودورة المعالجة وSLA من مكان واحد.</MudText>
        </div>
        <MudSpacer />
        <AuthorizeView Roles="Supervisor,Administrator">
            <Authorized>
                <MudButton Color="Color.Warning"
                           Variant="Variant.Outlined"
                           Disabled="_evaluatingSla"
                           OnClick="EvaluateSlaAsync"
                           Class="ms-2">
                    @(_evaluatingSla ? "جارٍ تقييم SLA..." : "تقييم SLA")
                </MudButton>
            </Authorized>
        </AuthorizeView>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ToggleCreate">
            @(_showCreate ? "إغلاق النموذج" : "حالة جديدة")
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_slaError))
    {
        <MudAlert Severity="Severity.Error">@_slaError</MudAlert>
    }
    else if (!string.IsNullOrWhiteSpace(_slaMessage))
    {
        <MudAlert Severity="Severity.Info">@_slaMessage</MudAlert>
    }

    @if (_showCreate)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-6">
            <MudText Typo="Typo.h5" GutterBottom="true">إنشاء حالة</MudText>
            @if (!string.IsNullOrWhiteSpace(_createError))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_createError</MudAlert>
            }

            <MudGrid>
                <MudItem xs="12">
                    <MudTextField T="string" Label="العنوان" Variant="Variant.Outlined"
                                  @bind-Value="_title" Disabled="_creating" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="الوصف" Lines="4" Variant="Variant.Outlined"
                                  @bind-Value="_description" Disabled="_creating" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="نوع الحالة" Variant="Variant.Outlined"
                               @bind-Value="_caseType" Disabled="_creating">
                        @foreach (var option in CaseTypeOptions)
                        {
                            <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="الأولوية" Variant="Variant.Outlined"
                               @bind-Value="_priority" Disabled="_creating">
                        @foreach (var option in PriorityOptions)
                        {
                            <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_creating"
                       OnClick="CreateAsync" Class="mt-5">
                @(_creating ? "جارٍ الإنشاء..." : "إنشاء الحالة")
            </MudButton>
        </MudPaper>
    }

    @if (_departments.Count > 0)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-6">
            <MudStack Spacing="3">
                <div>
                    <MudText Typo="Typo.h5">قائمة انتظار القسم</MudText>
                    <MudText Typo="Typo.body2">الحالات الجديدة الموجهة للقسم ولم تُسند بعد.</MudText>
                </div>

                <MudSelect T="Guid?" Label="القسم" Variant="Variant.Outlined"
                           Value="_selectedDepartmentId" ValueChanged="SelectDepartmentAsync">
                    @foreach (var department in _departments)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)department.Id)">@department.Name</MudSelectItem>
                    }
                </MudSelect>

                @if (!string.IsNullOrWhiteSpace(_queueError))
                {
                    <MudAlert Severity="Severity.Error">@_queueError</MudAlert>
                }
                else if (_loadingQueue)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else if (_queueCases.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">لا توجد حالات بانتظار الاستلام في هذا القسم.</MudAlert>
                }
                else
                {
                    <MudTable Items="_queueCases" Hover="true" Dense="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>العنوان</MudTh>
                            <MudTh>الأولوية</MudTh>
                            <MudTh>وُجهت</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate Context="item">
                            <MudTd DataLabel="العنوان">@item.Title</MudTd>
                            <MudTd DataLabel="الأولوية">@DisplayPriority(item.Priority)</MudTd>
                            <MudTd DataLabel="وُجهت">@DisplayUtc(item.RoutedUtc)</MudTd>
                            <MudTd>
                                <MudStack Row="true" Spacing="1">
                                    <AuthorizeView Roles="Supervisor,Administrator">
                                        <Authorized>
                                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                                       Href="@($"/cases/{item.Id:D}")">
                                                فتح
                                            </MudButton>
                                        </Authorized>
                                    </AuthorizeView>
                                    <AuthorizeView Roles="Operator">
                                        <Authorized>
                                            <MudButton Size="Size.Small" Color="Color.Primary"
                                                       Variant="Variant.Filled"
                                                       Disabled="_claimingCaseId.HasValue"
                                                       OnClick="@(() => ClaimAsync(item.Id))">
                                                @(_claimingCaseId == item.Id ? "جارٍ الاستلام..." : "استلام")
                                            </MudButton>
                                        </Authorized>
                                    </AuthorizeView>
                                </MudStack>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudStack>
        </MudPaper>
    }

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
    }
    else if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_cases.Count == 0)
    {
        <MudAlert Severity="Severity.Info">لا توجد حالات متاحة لحسابك حتى الآن.</MudAlert>
    }
    else
    {
        <MudTable Items="_cases" Hover="true" Dense="true" Elevation="0" Outlined="true">
            <HeaderContent>
                <MudTh>العنوان</MudTh>
                <MudTh>النوع</MudTh>
                <MudTh>الأولوية</MudTh>
                <MudTh>الحالة</MudTh>
                <MudTh>القسم</MudTh>
                <MudTh>SLA</MudTh>
                <MudTh>الموعد</MudTh>
                <MudTh>آخر تحديث</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate Context="item">
                <MudTd DataLabel="العنوان">@item.Title</MudTd>
                <MudTd DataLabel="النوع">@DisplayCaseType(item.CaseType)</MudTd>
                <MudTd DataLabel="الأولوية">@DisplayPriority(item.Priority)</MudTd>
                <MudTd DataLabel="الحالة">@DisplayStatus(item.Status)</MudTd>
                <MudTd DataLabel="القسم">@DisplayDepartment(item.DepartmentId)</MudTd>
                <MudTd DataLabel="SLA">@DisplaySlaState(item.SlaState)</MudTd>
                <MudTd DataLabel="الموعد">@DisplayUtc(item.SlaTargetUtc)</MudTd>
                <MudTd DataLabel="آخر تحديث">@item.UpdatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Text"
                               Href="@($"/cases/{item.Id:D}")">فتح</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudStack>

@code {
    private static readonly (string Value, string Label)[] CaseTypeOptions =
    [
        ("customer-complaint", "شكوى عميل"),
        ("operational-incident", "حادث تشغيلي"),
        ("internal-service-request", "طلب خدمة داخلي"),
        ("access-request", "طلب صلاحية"),
        ("compliance-case", "حالة امتثال"),
        ("technical-escalation", "تصعيد تقني"),
        ("operational-exception", "استثناء تشغيلي")
    ];

    private static readonly (string Value, string Label)[] PriorityOptions =
    [
        ("low", "منخفضة"),
        ("medium", "متوسطة"),
        ("high", "عالية"),
        ("critical", "حرجة")
    ];

    private readonly List<CaseDto> _cases = [];
    private readonly List<DepartmentDto> _departments = [];
    private readonly List<CaseDto> _queueCases = [];
    private bool _loading = true;
    private bool _loadingQueue;
    private bool _showCreate;
    private bool _creating;
    private bool _evaluatingSla;
    private Guid? _selectedDepartmentId;
    private Guid? _claimingCaseId;
    private string? _loadError;
    private string? _queueError;
    private string? _createError;
    private string? _slaError;
    private string? _slaMessage;
    private string _title = string.Empty;
    private string _description = string.Empty;
    private string _caseType = "internal-service-request";
    private string _priority = "medium";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private void ToggleCreate()
    {
        _showCreate = !_showCreate;
        _createError = null;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var casesResult = await ApiClient.ListCasesAsync();
            if (casesResult.IsFailure || casesResult.Value is null)
            {
                _loadError = casesResult.Error ?? "تعذر تحميل الحالات.";
                return;
            }

            _cases.Clear();
            _cases.AddRange(casesResult.Value);

            var departmentsResult = await ApiClient.ListDepartmentsAsync();
            _departments.Clear();
            if (departmentsResult.IsSuccess && departmentsResult.Value is not null)
            {
                _departments.AddRange(departmentsResult.Value);
                if (!_selectedDepartmentId.HasValue
                    || !_departments.Any(item => item.Id == _selectedDepartmentId.Value))
                {
                    _selectedDepartmentId = _departments.FirstOrDefault()?.Id;
                }
            }

            await LoadQueueAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SelectDepartmentAsync(Guid? departmentId)
    {
        _selectedDepartmentId = departmentId;
        await LoadQueueAsync();
    }

    private async Task LoadQueueAsync()
    {
        _queueCases.Clear();
        _queueError = null;
        if (!_selectedDepartmentId.HasValue)
            return;

        _loadingQueue = true;
        try
        {
            var result = await ApiClient.GetDepartmentQueueAsync(_selectedDepartmentId.Value);
            if (result.IsFailure || result.Value is null)
            {
                _queueError = result.Error ?? "تعذر تحميل قائمة انتظار القسم.";
                return;
            }

            _queueCases.AddRange(result.Value.Cases);
        }
        finally
        {
            _loadingQueue = false;
        }
    }

    private async Task ClaimAsync(Guid caseId)
    {
        if (_claimingCaseId.HasValue)
            return;

        _claimingCaseId = caseId;
        _queueError = null;
        try
        {
            var result = await ApiClient.ClaimCaseAsync(caseId);
            if (result.IsFailure)
            {
                _queueError = result.Error ?? "تعذر استلام الحالة.";
                return;
            }

            await LoadAsync();
        }
        finally
        {
            _claimingCaseId = null;
        }
    }

    private async Task EvaluateSlaAsync()
    {
        if (_evaluatingSla)
            return;

        _evaluatingSla = true;
        _slaError = null;
        _slaMessage = null;
        try
        {
            var result = await ApiClient.EvaluateCaseSlaAsync(new EvaluateCaseSlaRequest(50));
            if (result.IsFailure || result.Value is null)
            {
                _slaError = result.Error ?? "تعذر تقييم SLA للحالات.";
                return;
            }

            var value = result.Value;
            _slaMessage = value.HasMore
                ? $"تم تقييم {value.EvaluatedCount} حالة وتسجيل {value.BreachedCount} خرقًا. توجد دفعة أخرى بحاجة للتقييم."
                : $"تم تقييم {value.EvaluatedCount} حالة وتسجيل {value.BreachedCount} خرقًا.";
            await LoadAsync();
        }
        finally
        {
            _evaluatingSla = false;
        }
    }

    private async Task CreateAsync()
    {
        if (_creating)
            return;

        _creating = true;
        _createError = null;
        try
        {
            var result = await ApiClient.CreateCaseAsync(new CreateCaseRequest(
                _title,
                _description,
                _caseType,
                _priority));

            if (result.IsFailure || result.Value is null)
            {
                _createError = result.Error ?? "تعذر إنشاء الحالة.";
                return;
            }

            Navigation.NavigateTo($"/cases/{result.Value.Id:D}");
        }
        finally
        {
            _creating = false;
        }
    }

    private string DisplayDepartment(Guid? departmentId)
    {
        if (!departmentId.HasValue)
            return "غير موجهة";

        return _departments.FirstOrDefault(item => item.Id == departmentId.Value)?.Name
            ?? departmentId.Value.ToString("D");
    }

    private static string DisplayCaseType(string value) => value switch
    {
        "customer-complaint" => "شكوى عميل",
        "operational-incident" => "حادث تشغيلي",
        "internal-service-request" => "طلب خدمة داخلي",
        "access-request" => "طلب صلاحية",
        "compliance-case" => "حالة امتثال",
        "technical-escalation" => "تصعيد تقني",
        "operational-exception" => "استثناء تشغيلي",
        _ => value
    };

    private static string DisplayPriority(string value) => value switch
    {
        "low" => "منخفضة",
        "medium" => "متوسطة",
        "high" => "عالية",
        "critical" => "حرجة",
        _ => value
    };

    private static string DisplayStatus(string value) => value switch
    {
        "new" => "جديدة",
        "assigned" => "مسندة",
        "in-progress" => "قيد المعالجة",
        "resolved" => "تم الحل",
        "closed" => "مغلقة",
        _ => value
    };

    private static string DisplaySlaState(string value) => value switch
    {
        "not-applicable" => "غير مفعّل",
        "active" => "ضمن المهلة",
        "met" => "تم ضمن المهلة",
        "breached" => "متجاوز",
        _ => value
    };

    private static string DisplayUtc(DateTimeOffset? value) =>
        value.HasValue
            ? value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            : "—";
}
