@inject MadarApiClient ApiClient
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (RequiresApproval(Case.CaseType))
{
    <MudPaper Elevation="0" Outlined="true" Class="pa-6">
        <MudText Typo="Typo.h5" GutterBottom="true">اعتماد الحالة</MudText>
        <MudText Typo="Typo.body2" Class="mb-4">
            هذا النوع من الحالات يتطلب اعتمادًا مستقلًا قبل تسجيل الحل. طالب الاعتماد لا يمكنه اتخاذ القرار على طلبه نفسه.
        </MudText>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
        }

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            @if (Case.Status == "in-progress" && CanRequestApproval() && CanCreateNewRequest())
            {
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           Disabled="_acting"
                           OnClick="RequestAsync"
                           Class="mb-4">
                    طلب اعتماد
                </MudButton>
            }

            @if (_latest is null)
            {
                <MudAlert Severity="Severity.Info">
                    لم يُطلب اعتماد لهذه الحالة بعد. لا يمكن تسجيل الحل حتى يتم إنشاء طلب اعتماد والموافقة عليه.
                </MudAlert>
            }
            else if (_latest.Status == "pending")
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4">
                    طلب الاعتماد الحالي بانتظار قرار مستخدم مخول مختلف عن طالب الاعتماد.
                </MudAlert>

                <AuthorizeView Roles="Supervisor,Administrator">
                    <Authorized>
                        @if (_currentUserId == _latest.RequestedByUserId)
                        {
                            <MudAlert Severity="Severity.Info" Class="mb-4">
                                لا يمكنك اعتماد الطلب الذي أنشأته بنفسك.
                            </MudAlert>
                        }
                        else
                        {
                            <MudTextField T="string"
                                          Label="ملاحظات القرار (اختياري)"
                                          Lines="3"
                                          Counter="1000"
                                          MaxLength="1000"
                                          Variant="Variant.Outlined"
                                          @bind-Value="_decisionNotes"
                                          Disabled="_acting" />
                            <MudStack Row="true" Spacing="2" Class="mt-3 mb-4">
                                <MudButton Color="Color.Success"
                                           Variant="Variant.Filled"
                                           Disabled="_acting"
                                           OnClick="@(() => DecideAsync("approve"))">
                                    موافقة
                                </MudButton>
                                <MudButton Color="Color.Error"
                                           Variant="Variant.Outlined"
                                           Disabled="_acting"
                                           OnClick="@(() => DecideAsync("reject"))">
                                    رفض
                                </MudButton>
                            </MudStack>
                        }
                    </Authorized>
                </AuthorizeView>
            }
            else if (_latest.Status == "approved")
            {
                <MudAlert Severity="Severity.Success" Class="mb-4">
                    تم اعتماد آخر طلب. يمكن للموظف المخول الآن تسجيل حل الحالة.
                </MudAlert>
            }
            else if (_latest.Status == "rejected")
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">
                    رُفض آخر طلب اعتماد. يجب استكمال المعالجة ثم إنشاء طلب اعتماد جديد قبل تسجيل الحل.
                </MudAlert>
            }

            @if (_approvals.Count > 0)
            {
                <MudText Typo="Typo.h6" Class="mt-5 mb-2">سجل الاعتمادات</MudText>
                <MudTable Items="_approvals" Dense="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>الطلب</MudTh>
                        <MudTh>طالب الاعتماد</MudTh>
                        <MudTh>الحالة</MudTh>
                        <MudTh>المراجع</MudTh>
                        <MudTh>القرار</MudTh>
                        <MudTh>الملاحظات</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="approval">
                        <MudTd>@approval.RequestedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
                        <MudTd>@approval.RequestedByDisplayName</MudTd>
                        <MudTd>@DisplayStatus(approval.Status)</MudTd>
                        <MudTd>@(approval.ReviewedByDisplayName ?? "—")</MudTd>
                        <MudTd>@(approval.DecidedUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</MudTd>
                        <MudTd>@(approval.DecisionNotes ?? "—")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        }
    </MudPaper>
}

@code {
    [Parameter, EditorRequired]
    public CaseDto Case { get; set; } = default!;

    private readonly List<CaseApprovalDto> _approvals = [];
    private CaseApprovalDto? _latest;
    private Guid? _currentUserId;
    private bool _canProgressAny;
    private bool _loading = true;
    private bool _acting;
    private string _decisionNotes = string.Empty;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        if (!RequiresApproval(Case.CaseType))
        {
            _loading = false;
            return;
        }

        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var principal = authenticationState.User;
        var userIdValue = principal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _currentUserId = Guid.TryParse(userIdValue, out var userId) ? userId : null;
        _canProgressAny = principal.IsInRole("Supervisor") || principal.IsInRole("Administrator");

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await ApiClient.ListCaseApprovalsAsync(Case.Id);
            if (result.IsFailure || result.Value is null)
            {
                _error = result.Error ?? "تعذر تحميل سجل اعتماد الحالة.";
                return;
            }

            _approvals.Clear();
            _approvals.AddRange(result.Value);
            _latest = _approvals.LastOrDefault();
        }
        finally
        {
            _loading = false;
        }
    }

    private bool CanRequestApproval() =>
        _currentUserId.HasValue
        && (Case.AssignedToUserId == _currentUserId || _canProgressAny);

    private bool CanCreateNewRequest() =>
        _latest is null || _latest.Status == "rejected";

    private async Task RequestAsync()
    {
        if (_acting)
            return;

        _acting = true;
        _error = null;
        try
        {
            var result = await ApiClient.RequestCaseApprovalAsync(Case.Id);
            if (result.IsFailure || result.Value is null)
            {
                _error = result.Error ?? "تعذر إنشاء طلب الاعتماد.";
                return;
            }

            await LoadAsync();
        }
        finally
        {
            _acting = false;
        }
    }

    private async Task DecideAsync(string decision)
    {
        if (_acting || _latest is null)
            return;

        _acting = true;
        _error = null;
        try
        {
            var result = await ApiClient.DecideCaseApprovalAsync(
                Case.Id,
                _latest.Id,
                new DecideCaseApprovalRequest(decision, _decisionNotes));
            if (result.IsFailure || result.Value is null)
            {
                _error = result.Error ?? "تعذر حفظ قرار الاعتماد.";
                return;
            }

            _decisionNotes = string.Empty;
            await LoadAsync();
        }
        finally
        {
            _acting = false;
        }
    }

    private static bool RequiresApproval(string caseType) =>
        caseType is "access-request" or "compliance-case";

    private static string DisplayStatus(string status) => status switch
    {
        "pending" => "بانتظار القرار",
        "approved" => "معتمد",
        "rejected" => "مرفوض",
        _ => status
    };
}
