@inherits LayoutComponentBase
@inject MadarApiClient ApiClient
@inject MadarAuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation

<MudThemeProvider IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">مدار</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized Context="auth">
                <MudButton Href="/cases" Variant="Variant.Text">الحالات</MudButton>
                <AuthorizeView Roles="Administrator">
                    <Authorized>
                        <MudButton Href="/admin/departments" Variant="Variant.Text">إدارة الأقسام</MudButton>
                    </Authorized>
                </AuthorizeView>
                <MudText Typo="Typo.body2" Class="mx-3">@auth.User.Identity?.Name</MudText>
                <MudButton Variant="Variant.Outlined" OnClick="LogoutAsync">تسجيل الخروج</MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/login" Variant="Variant.Text">تسجيل الدخول</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>
    <MudMainContent dir="rtl">
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private async Task LogoutAsync()
    {
        var result = await ApiClient.LogoutAsync();
        if (!result.IsSuccess)
            return;

        AuthenticationState.Refresh();
        Navigation.NavigateTo("/login");
    }
}
