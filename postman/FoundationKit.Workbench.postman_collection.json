{
  "info": {
    "_postman_id": "4f6c2d31-93ec-4d6e-b247-2f6ecb359b11",
    "name": "FoundationKit Dual Full-Stack API",
    "description": "The same user and admin request contracts consumed by the Blazor portals. Run User/Create, then Admin/Queue and Admin/Review, then User/Get Status to see the integration boundary.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5057"
    },
    {
      "key": "userRequestId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Shared Platform",
      "item": [
        {
          "name": "Runtime",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/runtime"
          }
        },
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          }
        },
        {
          "name": "Capability Catalog",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/catalog"
          }
        }
      ]
    },
    {
      "name": "User Full Stack",
      "item": [
        {
          "name": "Create User Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', function () { pm.response.to.have.status(201); });",
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('userRequestId', response.id);",
                  "pm.test('Starts submitted', function () { pm.expect(response.status).to.eql('submitted'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "postman-user-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectName\": \"نظام إدارة مراسلات\",\n  \"projectType\": \"نظام خدمة عملاء\",\n  \"audience\": \"موظفو خدمة العملاء والمشرفون\",\n  \"goal\": \"إدارة المحادثات والمهام والتصعيد من واجهة داخلية موحدة\",\n  \"selectedCapabilityIds\": [\n    \"aggregate-domain-events\",\n    \"commands-queries\",\n    \"repository-ports\",\n    \"ef-repository\",\n    \"result-http-mapping\",\n    \"typed-api-results\"\n  ],\n  \"priorities\": \"الصلاحيات، سجل التدقيق، سرعة الاستجابة\",\n  \"notes\": \"مثال عام غير سري مطابق لعقد CreateUserRequest.\"\n}"
            },
            "url": "{{baseUrl}}/api/user/requests",
            "description": "Creates the user-side SQL Server record using CreateUserRequest."
          }
        },
        {
          "name": "Get User Request Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/user/requests/{{userRequestId}}",
            "description": "Returns the current state after the admin workflow processes the request."
          }
        }
      ]
    },
    {
      "name": "Admin Full Stack",
      "item": [
        {
          "name": "Get Submitted Queue",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/requests?status=submitted",
            "description": "Reads the SQL-backed admin work queue."
          }
        },
        {
          "name": "Approve User Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Reviewed', function () { pm.response.to.have.status(200); });",
                  "const response = pm.response.json();",
                  "pm.test('Approved', function () { pm.expect(response.status).to.eql('approved'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "postman-admin-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approve\",\n  \"reviewedBy\": \"Admin User\",\n  \"notes\": \"تمت مراجعة الطلب واعتماده من لوحة الإدارة.\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/requests/{{userRequestId}}/review",
            "description": "Writes AdminReviews and changes the linked user request status in one unit of work."
          }
        },
        {
          "name": "Get Approved Queue",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/requests?status=approved"
          }
        }
      ]
    }
  ]
}
